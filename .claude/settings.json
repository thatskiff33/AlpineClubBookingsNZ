{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Agent(effort:max)",
      "Bash(npx *)",
      "Bash(pnpx *)",
      "Bash(pnpm dlx *)",
      "Bash(prisma format *)",
      "Bash(pnpm exec prisma format *)",
      "Bash(gh issue view *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/agent-hooks/dispatch.mjs"],
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/agent-hooks/dispatch.mjs"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
