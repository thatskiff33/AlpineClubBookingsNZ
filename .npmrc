# This repository installs with pnpm (#3673). The pin is `packageManager` in
# package.json, and pnpm's own settings live in pnpm-workspace.yaml.
#
# This file exists for npm only. With `engine-strict`, npm refuses to install
# here because package.json's `engines.npm` can never be satisfied, so running
# `npm install` or `npm ci` out of habit stops before it writes a
# package-lock.json or a node_modules tree. (Today npm usually fails even
# earlier, on the `catalog:` dependency specifiers or the missing npm lockfile;
# this is the backstop that holds whichever of those changes.) pnpm reads only registry and auth
# settings from .npmrc, so this line changes nothing for pnpm.
engine-strict=true
