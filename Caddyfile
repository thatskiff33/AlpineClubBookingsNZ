{$DOMAIN} {
	# X-Frame-Options is PATH-SCOPED so the edge states the same intent the app
	# does (#2246). /display is deliberately framed by the admin's own sandboxed
	# preview surfaces (LTV-036, ADR-003 §5) and `src/lib/csp.ts` sets SAMEORIGIN
	# on it, but a blanket edge DENY REPLACED that value — the previews worked
	# only because CSP2 tells browsers to ignore X-Frame-Options when
	# `frame-ancestors` is present. Scoping the header here removes that
	# dependence on a browser precedence rule.
	#
	# Every other path keeps a GUARANTEED DENY set at the edge, including
	# /finance-legacy* (a reverse-proxied third-party upstream) and /images/*,
	# neither of which the app's own middleware covers. Deliberately NOT the
	# set-if-absent `?X-Frame-Options` form: that would downgrade a guaranteed
	# edge control into an advisory one on every route, so any upstream emitting
	# a permissive value would win.
	#
	# X-Frame-Options is set in TWO places and BOTH are load-bearing. Do not
	# "de-duplicate" them — deleting either one is a regression:
	#
	#  1. The DEFERRED, scoped pair below (the `>` prefix). `>` rewrites the
	#     header as the response is written, so the edge value REPLACES the
	#     upstream's instead of sitting next to it. Without it Caddy sets the
	#     header before proxying and the app's value is APPENDED, so a response
	#     carries two conflicting X-Frame-Options values (measured against
	#     caddy:2 with a permissive upstream: a plain set left both `DENY` and
	#     `ALLOWALL` on the same response).
	#  2. The EAGER `X-Frame-Options "DENY"` in the shared `header { }` block
	#     below. The deferred rewrite lives in a ResponseWriter wrapper that is
	#     unwound when a handler returns an ERROR, so Caddy's error chain writes
	#     the response without it: a 502 when an upstream is down (including
	#     /finance-legacy*), the 413 from the request_body cap below, any 5xx.
	#     Those responses never reach Next either, so they carry no CSP and no
	#     `frame-ancestors` fallback — the eager set is the only thing that makes
	#     DENY GUARANTEED on them. On a normal proxied response the deferred pair
	#     runs afterwards and overwrites it, so there is still exactly one value.
	#
	# Measured against caddy:2 with a permissive upstream, exactly one
	# X-Frame-Options per response: /display and /display/ → SAMEORIGIN; /other,
	# /DISPLAY, /display/foo, /display-foo, /images/* → DENY; 502 → DENY;
	# 413 → DENY.
	#
	# `path_regexp`, not `path`, because it is case-SENSITIVE and so mirrors the
	# app's own `pathname === "/display"` comparison (Caddy's `path` matcher is
	# case-insensitive, which would hand SAMEORIGIN to `/DISPLAY`); `/?` mirrors
	# the trailing-slash normalisation in `src/lib/csp.ts`.
	#
	# The matcher is NOT byte-identical to the app's comparison, and cannot be:
	# Caddy matches on the CLEANED, PERCENT-DECODED path but forwards the RAW
	# URI, so the app sees a different string. Measured divergences, where the
	# edge relaxes to SAMEORIGIN but the app still sends DENY: //display,
	# /display//, /%64isplay, /dis%70lay, /display%2F. That is acceptable — those
	# responses still carry the app's own `frame-ancestors 'none'`, which
	# browsers honour over X-Frame-Options, and SAMEORIGIN never permits more
	# than same-origin framing. The dangerous inverse (app relaxes, edge denies,
	# breaking the preview) is impossible, because both paths the app relaxes sit
	# inside the edge's match set.
	#
	# `header` runs ahead of `handle` in Caddy's directive order, so both
	# matchers also cover the handled paths below.
	# Guarded by src/lib/__tests__/edge-frame-options-static.test.ts.
	@display path_regexp ^/display/?$
	@not_display not path_regexp ^/display/?$
	header @display >X-Frame-Options "SAMEORIGIN"
	header @not_display >X-Frame-Options "DENY"
	header {
		X-Content-Type-Options "nosniff"
		# The eager guaranteed floor — point 2 of the note above. This is the
		# value error responses (502/413/5xx) carry, because they bypass the
		# deferred rewrite; the deferred pair replaces it on every normal
		# response. Removing this line silently makes error pages framable.
		X-Frame-Options "DENY"
		# Disabled: the legacy XSS auditor is removed from modern browsers and
		# enabling it could introduce information leaks in older ones. CSP is the control.
		X-XSS-Protection "0"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		# CSP is emitted by Next middleware so script nonces are generated per request.
		# style-src intentionally keeps 'unsafe-inline' there while Tailwind/Radix runtime styles are audited.
		# Defensive baseline: only applied if Next omits the header (e.g. middleware regression).
		# Caddy's `?` prefix means "set if not already present" so it never intersects with Next's policy.
		#
		# Note what this fallback CANNOT rescue, because it was mistaken for a
		# safety net once (#2404). It carries no `'nonce-…'` source, so on any
		# HTML document the app renders WITHOUT its own policy this line does not
		# protect the page — it breaks it, blocking every inline script Next
		# emitted unnonced. That was the live failure on static-asset URLs that
		# nothing served: `/foo.png` answered 404 with ~29KB of HTML and 19
		# unnonced inline scripts, and this header blocked all 19.
		#
		# The app now closes that at its own end rather than relying on the edge:
		# `src/proxy.ts`'s matcher no longer skips paths by file extension, so
		# every response that renders a document carries a nonced policy of its
		# own, and asset-shaped misses are answered with an empty 404 by
		# `src/app/asset-not-found/route.ts` (which sets its own
		# `default-src 'none'`, so it does not depend on this line either). Keep
		# this fallback: it is still the floor for a response that reaches Caddy
		# without one — an upstream that is not our app, or a middleware
		# regression. Just do not treat "Caddy supplies a CSP" as meaning a page
		# without its own is safe.
		?Content-Security-Policy "default-src 'self'"
	}
	# Guaranteed request-body backstop (#2235): drop oversize bodies at the
	# edge before they reach the app. Set comfortably above the largest
	# legitimate in-app cap (80MB image-manager batch, ~52MB config bundle);
	# the app's streamed per-route caps do the precise enforcement.
	request_body {
		max_size 100MB
	}
	# Rewrite legacy /images/* requests to the runtime-serving API route so
	# uploaded images are served correctly without restarting containers.
	handle /images/* {
		uri strip_prefix /images
		rewrite * /api/images/uploaded{path}
		import /etc/caddy/deploy/tacbookings-active.caddy
	}
	handle /finance-legacy* {
		forward_auth app:3000 {
			uri /api/finance/legacy-dashboard/auth
		}
		reverse_proxy 172.26.3.200:8501
	}
	import /etc/caddy/deploy/tacbookings-active.caddy
}

# Canonicalize the www host onto the apex so a session established on one origin
# is never orphaned on the other (the session cookie is host-only). Mirrors the
# bookings./dashboard. redirects below; preserves the full path + query via {uri}.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

bookings.{$DOMAIN} {
	@root path /
	redir @root https://{$DOMAIN}/dashboard permanent
	redir * https://{$DOMAIN}{uri} permanent
}

dashboard.{$DOMAIN} {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# Disabled: the legacy XSS auditor is removed from modern browsers and
		# enabling it could introduce information leaks in older ones. CSP is the control.
		X-XSS-Protection "0"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}
	redir * https://{$DOMAIN}/finance-legacy{uri} permanent
}

# MiroTalk video-meeting host. MEET_HOST must be the EXACT public hostname you
# browse to (e.g. meet.lwtc.org.nz) — it is NOT necessarily a subdomain of
# $DOMAIN, so it is its own variable. MIROTALK_UPSTREAM is where MiroTalk is
# reachable FROM THE CADDY CONTAINER: host.docker.internal:3010 for a MiroTalk
# started with its own `docker run` (needs the extra_hosts entry on the caddy
# service), or a compose service name like mirotalk:3010. Defaults keep Caddy
# valid (and this block inert) when the vars are unset, so the main site is
# never affected. DNS for MEET_HOST must point at this VM and ports 80+443 must
# be open so Caddy can obtain the TLS certificate.
{$MEET_HOST:meet.localhost} {
    header {
        Permissions-Policy "camera=(self), microphone=(self), display-capture=(self)"
        Strict-Transport-Security "max-age=63072000; includeSubDomains"
    }
    reverse_proxy {$MIROTALK_UPSTREAM:host.docker.internal:3010}
}
