{
	# Access logging, with URL tokens and query secrets redacted (#3293).
	#
	# Before this, only Caddy's error log existed, so a request that SUCCEEDED
	# left no trace at all — which is why the connection-reuse race this issue
	# fixes could not be measured after the fact: two logged 502s, and no way to
	# tell whether that was two attempts out of two or two out of fifty.
	#
	# The filter is attached to the DEFAULT logger rather than to the access log,
	# because Caddy's `http.log.error` entries carry the full request too and were
	# already printing URLs in full. `deploy/caddy/log-redaction.caddy` carries the
	# rules and the reasoning; each site opts in with a bare `log`.
	#
	# `wrap json` matches what this logger already emits when it is not attached to
	# a terminal, so nothing about the existing lines changes shape.
	log default {
		format filter {
			wrap json
			import /etc/caddy/deploy/log-redaction.caddy
		}
	}
}

{$STAGING_CADDY_SITE:http://localhost} {
	# Guaranteed request-body backstop (#2235); mirrors the production
	# Caddyfile. See docs/SECURITY-ATTACK-SURFACE.md.
	request_body {
		max_size 100MB
	}
	# X-Frame-Options is PATH-SCOPED; mirrors the production Caddyfile (#2246),
	# where the reasoning is written out in full. In short: `src/lib/csp.ts` sets
	# SAMEORIGIN on /display so the admin's own sandboxed preview surfaces can
	# frame it, and a blanket edge DENY replaced that value. `path_regexp` is
	# case-sensitive, so it mirrors the app's exact `pathname === "/display"`
	# comparison; `/?` mirrors that file's trailing-slash normalisation. Caddy
	# matches on the cleaned, percent-decoded path but forwards the raw URI, so a
	# few encoded/double-slash variants (//display, /display//, /%64isplay,
	# /dis%70lay, /display%2F) relax at the edge while the app still denies —
	# harmless, because the app's own `frame-ancestors 'none'` still governs and
	# SAMEORIGIN never permits more than same-origin framing. Deliberately NOT
	# the set-if-absent `?X-Frame-Options` form.
	#
	# BOTH X-Frame-Options directives below are needed; do not delete either.
	# The `>` prefix is a deferred set, so the edge value overwrites the app's
	# rather than being appended alongside it as a second, conflicting header —
	# but that rewrite is unwound when a handler returns an error, so the
	# eager unscoped DENY in the shared block is what keeps 502/413/5xx
	# responses (which carry no CSP either) guaranteed-denied. Every other path,
	# including /images/* below, therefore keeps a guaranteed DENY.
	# Guarded by src/lib/__tests__/edge-frame-options-static.test.ts.
	@display path_regexp ^/display/?$
	@not_display not path_regexp ^/display/?$
	header @display >X-Frame-Options "SAMEORIGIN"
	header @not_display >X-Frame-Options "DENY"
	header {
		X-Content-Type-Options "nosniff"
		# The eager guaranteed floor for error responses — see the note above.
		X-Frame-Options "DENY"
		# Disabled: the legacy XSS auditor is removed from modern browsers and
		# enabling it could introduce information leaks in older ones. CSP is the control.
		X-XSS-Protection "0"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		# CSP is emitted by Next proxy so script nonces are generated per request.
		# style-src intentionally keeps 'unsafe-inline' there while Tailwind/Radix runtime styles are audited.
		# Defensive baseline: only applied if Next omits the header (e.g. middleware regression).
		# Caddy's `?` prefix means "set if not already present" so it never intersects with Next's policy.
		# Because it is set-if-absent it is a no-op in the normal case: its only
		# effect is on failure, where a bare `default-src 'self'` breaks every
		# nonce'd script and so makes a proxy/middleware regression LOUD on
		# staging instead of silent. That is what staging is for.
		?Content-Security-Policy "default-src 'self'"
	}

	# Send this site's access entries to the redacting default logger (#3293).
	log

	# Rewrite legacy /images/* requests to the runtime-serving API route.
	handle /images/* {
		uri strip_prefix /images
		rewrite * /api/images/uploaded{path}
		reverse_proxy app:3000 {
			# See deploy/caddy/tacbookings-active.caddy (#3293).
			transport http {
				keepalive 30s
			}
		}
	}

	reverse_proxy app:3000 {
		# Caddy must release a pooled connection BEFORE the app closes it
		# (#3293). Mirrors deploy/caddy/tacbookings-active.caddy.
		transport http {
			keepalive 30s
		}
	}
}
