{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    // #2802: tsconfig.json turns `noUncheckedIndexedAccess` on as the
    // permanent rule for application code. Programme #2694 (the ratchet that
    // reached zero) was scoped to `tsconfig.json` throughout — "application
    // code before tests" — and forcing the flag on here surfaces thousands of
    // pre-existing diagnostics scattered across hundreds of test files, none
    // of which #2694 ever measured or budgeted. It is several times the whole
    // migration this programme just finished, so widening the flag to tests is
    // a separate programme rather than the tail of this stage; turning it back
    // off here keeps that decision explicit instead of silent, and keeps
    // `npm run typecheck` green in the meantime.
    //
    // #3363 IS THE ONE HOME for how many, and for the plan. The counts are
    // measurements rather than facts about the design, so a second copy of them
    // goes stale silently and nobody can tell which copy is wrong — which is
    // why neither this comment nor docs/TESTING.md restates them.
    "noUncheckedIndexedAccess": false
  },
  // Every Vitest test under the configured src/ and scripts/ collection roots.
  //
  // `tsconfig.json` excludes test/spec files in these roots and every
  // `__tests__` directory to keep test code out of the app project. This file
  // used to re-include only the `src/` half of what that exclusion removed. The
  // other half — the tests under `scripts/__tests__/` — was therefore in
  // neither project, so `npm run typecheck` walked straight past it. That
  // included the tests for the
  // file-size gate this PR adds: a gate whose own tests were outside the
  // typechecker (#2875).
  //
  // The patterns name every TypeScript extension Vitest and TypeScript share —
  // `.ts`, `.tsx`, `.mts` and `.cts` — and nothing else. `allowJs` is off
  // (#2693), so the `scripts/**/*.test.mjs` suites Vitest also collects are
  // deliberately NOT roots here: they run, but no project claims to typecheck
  // them, exactly as before, when `checkJs: false` loaded them and checked
  // nothing. `src/lib/__tests__/typecheck-project-coverage.test.ts` pins that
  // list, so a new JavaScript test cannot appear without being named there.
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test.mts",
    "src/**/*.test.cts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.spec.mts",
    "src/**/*.spec.cts",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "src/**/__tests__/**/*.mts",
    "src/**/__tests__/**/*.cts",
    "scripts/**/*.test.ts",
    "scripts/**/*.test.tsx",
    "scripts/**/*.test.mts",
    "scripts/**/*.test.cts",
    "scripts/**/*.spec.ts",
    "scripts/**/*.spec.tsx",
    "scripts/**/*.spec.mts",
    "scripts/**/*.spec.cts",
    "scripts/**/__tests__/**/*.ts",
    "scripts/**/__tests__/**/*.tsx",
    "scripts/**/__tests__/**/*.mts",
    "scripts/**/__tests__/**/*.cts",
    "vitest.config.mts",
    "vitest.setup.ts",
    "vitest.clock-setup.ts"
  ],
  "exclude": ["node_modules"]
}
