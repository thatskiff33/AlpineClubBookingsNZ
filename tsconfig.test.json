{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    // #2693: tests run only on Node 24, which carries the ES2024 standard
    // library in full. One census suite already relies on `Map.groupBy`
    // (`src/lib/__tests__/e2e-booking-create-isolation.test.ts`), and the app
    // project's ES2022 `lib` describes what a browser must offer, not a ceiling
    // for a Node-only test. Measured at the baseline: that one site is the only
    // use beyond ES2022 in any project, so this is a deliberate, narrow widening
    // rather than a return to `esnext`.
    "lib": ["dom", "dom.iterable", "es2024"]
  },
  // Every Vitest test under the configured src/ and scripts/ collection roots.
  //
  // `tsconfig.json` excludes test/spec files in these roots and every
  // `__tests__` directory to keep test code out of the app project. This file
  // used to re-include only the `src/` half of what that exclusion removed. The
  // other half — the tests under `scripts/__tests__/` — was therefore in
  // neither project, so `npm run typecheck` walked straight past it. That
  // included the tests for the
  // file-size gate this PR adds: a gate whose own tests were outside the
  // typechecker (#2875).
  //
  // The patterns name every TypeScript extension Vitest and TypeScript share —
  // `.ts`, `.tsx`, `.mts` and `.cts` — and nothing else. `allowJs` is off
  // (#2693), so the `scripts/**/*.test.mjs` suites Vitest also collects are
  // deliberately NOT roots here: they run, but no project claims to typecheck
  // them, exactly as before, when `checkJs: false` loaded them and checked
  // nothing. `src/lib/__tests__/typecheck-project-coverage.test.ts` pins that
  // list, so a new JavaScript test cannot appear without being named there.
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test.mts",
    "src/**/*.test.cts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.spec.mts",
    "src/**/*.spec.cts",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "src/**/__tests__/**/*.mts",
    "src/**/__tests__/**/*.cts",
    "scripts/**/*.test.ts",
    "scripts/**/*.test.tsx",
    "scripts/**/*.test.mts",
    "scripts/**/*.test.cts",
    "scripts/**/*.spec.ts",
    "scripts/**/*.spec.tsx",
    "scripts/**/*.spec.mts",
    "scripts/**/*.spec.cts",
    "scripts/**/__tests__/**/*.ts",
    "scripts/**/__tests__/**/*.tsx",
    "scripts/**/__tests__/**/*.mts",
    "scripts/**/__tests__/**/*.cts",
    "vitest.config.mts",
    "vitest.setup.ts",
    "vitest.clock-setup.ts"
  ],
  "exclude": ["node_modules"]
}
