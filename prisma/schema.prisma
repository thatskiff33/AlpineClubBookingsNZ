enum BookingChangeRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  // #2365 policy-exception outcomes. Only ever written onto a POLICY_EXCEPTION
  // kind request (a locked-period change never reaches them), so a draining old
  // colour — whose pending queue selects `status: REQUESTED` — never reads one.
  // CANCELLED: the member withdrew the proposal before an admin decided.
  // SUPERSEDED: a newer proposal (or live-booking drift) replaced this one.
  CANCELLED
  SUPERSEDED
  // #2553: the hold ran out. A HOLD-mode policy-exception request reserves real
  // beds while it waits (#2525); nobody approved, rejected or withdrew it before
  // its `holdExpiresAt` deadline, so the reaper cron released the beds and closed
  // the request. Written ONLY by that cron, and only onto a POLICY_EXCEPTION row.
  EXPIRED
}

// #2365: which flavour of admin-reviewed change a BookingChangeRequest carries.
// LOCKED_PERIOD is the original today/past-night edit that needs admin hands to
// apply; POLICY_EXCEPTION is a member request to override an eligible SOFT
// booking-policy failure (minimum stay, adult-member hosting) on the frozen
// proposal the row stores. The two share the queue and the row but never the
// evidence columns: a locked-period row leaves every policy-exception column
// null, and a policy-exception row carries the frozen structured evidence.
enum BookingChangeRequestKind {
  LOCKED_PERIOD
  POLICY_EXCEPTION
}

