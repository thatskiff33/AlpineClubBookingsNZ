// ---------------------------------------------------------------------------
// Lodge Induction Sign-Off (induction checklist + nomination eligibility gate)
//
// A versioned competency checklist (sourced from the club's 2008 Induction
// Sheet) recorded per member. A member becomes eligible to nominate new members
// only once their own induction is signed off AND they meet a minimum
// membership tenure and minimum nights stayed (admin-configurable). Existing
// members who joined before the gate's effective date are grandfathered.
// ---------------------------------------------------------------------------

enum InductionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  VOIDED
}

enum InductionKind {
  NEW_MEMBER
  HUT_LEADER
  YOUTH_TO_FULL
  RE_INDUCTION
}

enum InductionSignerRole {
  NOMINATOR
  HUT_LEADER
  ADMIN
}

enum InductionCompletionSource {
  SIGN_OFFS
  ADMIN_OVERRIDE
}

enum InductionSectionPriority {
  EMERGENCY
  SECURITY
  STARTUP
  SHUTDOWN
  GENERAL
}

model InductionChecklistTemplate {
  id          String        @id @default(cuid())
  name        String
  version     String
  kind        InductionKind @default(NEW_MEMBER)
  sourceLabel String?
  isActive    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sections   InductionChecklistSection[]
  inductions MemberInduction[]

  @@index([isActive])
  @@index([kind, isActive])
}

model InductionChecklistSection {
  id          String                   @id @default(cuid())
  templateId  String
  title       String
  description String?
  priority    InductionSectionPriority
  sortOrder   Int                      @default(0)

  template InductionChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    InductionChecklistItem[]

  @@index([templateId])
}

model InductionChecklistItem {
  id                    String  @id @default(cuid())
  sectionId             String
  label                 String
  competencyPrompt      String?
  notesPrompt           String?
  isMandatory           Boolean @default(false)
  requiresDemonstration Boolean @default(false)
  sortOrder             Int     @default(0)
  legacySourceText      String?

  section InductionChecklistSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

model MemberInduction {
  id                 String                     @id @default(cuid())
  memberId           String
  templateId         String
  applicationId      String?                    @unique
  kind               InductionKind              @default(NEW_MEMBER)
  status             InductionStatus            @default(IN_PROGRESS)
  requiredSignOffs   Int                        @default(2)
  inductionDate      DateTime?
  completedAt        DateTime?
  completionSource   InductionCompletionSource?
  finalComments      String?
  voidedReason       String?
  createdByMemberId  String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  member          Member                          @relation("MemberInductions", fields: [memberId], references: [id], onDelete: Cascade)
  template        InductionChecklistTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  application     MemberApplication?              @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  signOffs        MemberInductionSignOff[]
  assignedSigners MemberInductionAssignedSigner[]

  @@index([memberId])
  @@index([templateId])
  @@index([status])
  @@index([kind])
}

model MemberInductionSignOff {
  id                  String              @id @default(cuid())
  inductionId         String
  signerMemberId      String?
  signerName          String
  signerRole          InductionSignerRole
  declarationAccepted Boolean             @default(false)
  comments            String?
  signedAt            DateTime            @default(now())

  induction MemberInduction @relation(fields: [inductionId], references: [id], onDelete: Cascade)
  signer    Member?         @relation("InductionSignOffSigner", fields: [signerMemberId], references: [id], onDelete: SetNull)

  @@unique([inductionId, signerMemberId])
  @@index([inductionId])
  @@index([signerMemberId])
}

model MemberInductionAssignedSigner {
  id          String    @id @default(cuid())
  inductionId String
  memberId    String
  emailSentAt DateTime?
  createdAt   DateTime  @default(now())

  induction MemberInduction @relation(fields: [inductionId], references: [id], onDelete: Cascade)
  member    Member          @relation("AssignedInductionSigners", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([inductionId, memberId])
  @@index([inductionId])
  @@index([memberId])
}

model MembershipNominationSettings {
  id                      String    @id @default("default")
  gateEnabled             Boolean   @default(false)
  minimumMembershipMonths Int       @default(12)
  minimumNights           Int       @default(6)
  requiredSignOffs        Int       @default(2)
  // NOT `@db.Date`, and that is a decision rather than an oversight (#2872,
  // CT-3). This column is MIXED: the admin panel sends a calendar day from an
  // `<input type="date">`, but `api/admin/membership-nomination-settings`
  // stamps `new Date()` — a real instant — the first time the gate is enabled
  // with the cutoff box left empty, which the panel's own help text presents as
  // ordinary use. A column with a clock writer is exactly what excluded
  // `MemberInduction.inductionDate` from the same migration. Narrowing it would
  // also make that migration's fail-closed preflight RAISE on any club that has
  // already enabled the gate that way. See "WHAT IS DELIBERATELY NOT HERE" in
  // prisma/migrations/20260825010000_narrow_calendar_date_columns/migration.sql.
  gateEffectiveFrom       DateTime?
  updatedByMemberId       String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

// Admin-configurable settings for the booking lockout that blocks members with
// an unpaid annual subscription. Single-row table (id = "default"), same
// pattern as MembershipNominationSettings. The subscription detection codes
// (account code / item code) are NOT stored here; they remain in the
// XeroAccountMapping "subscriptionIncome" row so there is a single source of
// truth shared with the Xero mappings panel.
// How a club treats a member whose season subscription is required but unpaid
// when they try to book (#2543). Replaced the old boolean `enabled` toggle, which
// was backfilled into this enum and dropped in the same release (#2561):
//   NO_BLOCK           - no subscription gate at all; they book at member rates.
//   HARD_BLOCK         - the historical behaviour: 403 SUBSCRIPTION_REQUIRED /
//                        GUEST_SUBSCRIPTION_REQUIRED. The effective default, so
//                        every existing club is unchanged until an admin moves.
//   NON_MEMBER_PRICING - they may book, but their own nights price at the
//                        built-in NON_MEMBER rate and the booking must contain at
//                        least one paid-up adult member (else it is refused with
//                        an admin-override request path).
enum SubscriptionLockoutMode {
  NO_BLOCK
  HARD_BLOCK
  NON_MEMBER_PRICING
}

model MembershipLockoutSettings {
  id                            String                  @id @default("default")
  // Three-way lockout policy (#2543), and the ONLY record of it: the legacy
  // boolean `enabled` this replaced was backfilled into this column and dropped
  // in the same release, as an explicit maintenance-window migration (owner
  // directive on #2561). MANDATORY, defaulting to HARD_BLOCK — the behaviour the
  // old `enabled = true` default produced — so a fresh install starts where every
  // existing club already was. Read it through
  // `loadMembershipLockoutSettings`/`resolveSubscriptionLockoutMode` rather than
  // directly, so the closed vocabulary is enforced in one place.
  mode                          SubscriptionLockoutMode @default(HARD_BLOCK)
  // Membership financial year-end month (1-12). Null = follow the connected
  // Xero organisation's accounting financial year. A value overrides it when the
  // membership subscription year differs from the accounting year.
  financialYearEndMonthOverride Int?
  // When true, an invoice whose reference/description text reads like a
  // membership subscription also counts, in addition to account/item code.
  textFallbackEnabled           Boolean  @default(true)
  // When true (#2109), paid detection matches ANY item code stamped on the fee
  // schedule (distinct MembershipAnnualFeeComponent.xeroItemCode) in addition to
  // the single subscriptionIncome item code, so clubs that bill one item code
  // per membership type + age tier are still recognised as paid. Default false =
  // single-code behaviour byte-for-byte.
  useFeeScheduleItemCodes       Boolean  @default(false)
  updatedByMemberId             String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Lobby TV Display (docs/lobby-display/design.md, fork epic #25)
// ---------------------------------------------------------------------------

// A page layout (ADR-003 §1, LTV-024): the structural HTML body with named
// areas/slots, a default CSS block, and per-slot metadata. All layouts share a
// fixed header and an editable footer (page furniture, not part of the body).
// `areas` is an ordered list of slot descriptors
// ({ key, description, kind: static|conditional|rotator, condition?,
// rotateSeconds?, children?, defaultContent }) validated app-side (LTV-027/030),
// exactly as the retired definition Json was.
model DisplayLayout {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?
  bodyHtml    String   @db.Text
  defaultCss  String   @db.Text
  areas       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates DisplayTemplate[]
}

// A selectable display design (ADR-003 §1, LTV-024): built on a DisplayLayout,
// it fills each declared slot with content or an embedded module, layers CSS
// overrides on the layout default, and carries the footer content. It renders
// dynamically against whichever lodge its display is bound to; `slotContent`
// maps areaKey -> { html } or { module, options? }. A layout still referenced
// by a template cannot be deleted (Restrict).
model DisplayTemplate {
  id           String   @id @default(cuid())
  key          String   @unique @db.VarChar(80)
  name         String   @db.VarChar(120)
  layoutId     String
  slotContent  Json
  cssOverrides String   @db.Text
  footerHtml   String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  layout  DisplayLayout        @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  devices LodgeDisplayDevice[]

  @@index([layoutId])
}

// A physical lobby display (TV/browser) paired to exactly one lodge. The raw
// display credential is never stored — only its hash (docs/TOKEN_HASHING.md);
// pairing codes are short-lived and single-use. Lifecycle: created → pairing
// (code active) → paired → revoked (docs/lobby-display/design.md §4).
// Deleting a bound template falls the device back to the club default
// (SetNull) rather than breaking the device.
model LodgeDisplayDevice {
  id                   String    @id @default(cuid())
  lodgeId              String
  name                 String    @db.VarChar(120)
  pairingCode          String?   @db.VarChar(16)
  pairingCodeExpiresAt DateTime?
  tokenHash            String?   @unique
  templateId           String?
  // Per-device state-poll cadence in seconds (LTV-039, issue #85; consolidates
  // #66). null = the client default (~60s). Clamped server-side to 15–600 on
  // read and write. The poll doubles as the device heartbeat, so this also
  // governs how often lastSeenAt refreshes.
  pollSeconds          Int?
  lastSeenAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  lodge    Lodge            @relation(fields: [lodgeId], references: [id], onDelete: Restrict)
  template DisplayTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([lodgeId])
  @@index([templateId])
}

// How guest names are reduced by the lobby display's privacy serialiser
// (fork issue #28, docs/lobby-display/design.md §10). Enforcement lives in
// src/lib/lodge-display-state.ts — the single choke point for what a public
// screen may show. Minors are never individually named at ANY level.
enum DisplayNameGranularity {
  FULL_NAME
  FIRST_NAME_SURNAME_INITIAL
  FIRST_NAME_ONLY
  COUNTS_ONLY
}

// ---------------------------------------------------------------------------
// Club events calendar (committee meetings, working bees, social events, ...)
//
// A club-wide event calendar shown to every logged-in member (read-only) and
// editable by Full Admins with lodge:edit and by committee members (any active
// CommitteeAssignment) — see src/lib/calendar-access.ts for the single write
// gate. Times are stored as absolute instants; all-day events carry allDay=true
// with endsAt null. A meeting event carries isMeeting=true and a MiroTalk room
// slug (meetingRoom); the join URL is built server-side from the MIROTALK_URL
// env var so it is environment-specific (localhost in dev, the meet host in
// prod). createdById is a bare Member id (no relation) to keep this table's
// migration surface minimal — it never drives cascades or joins.
// ---------------------------------------------------------------------------
model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  location    String?
  details     String?   @db.Text
  allDay      Boolean   @default(false)
  startsAt    DateTime
  endsAt      DateTime?
  isMeeting   Boolean   @default(false)
  meetingRoom String?
  // Optional client-supplied dedup token for a create. A duplicate replay of the
  // same key returns the first event instead of inserting another. NULLs are
  // distinct in a Postgres unique index, so unkeyed events never collide.
  idempotencyKey String? @unique
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Recurrence (#calendar-recurring). A recurring event is materialised as one
  // CalendarEvent row per occurrence, all sharing a seriesId. Editing a single
  // occurrence sets detachedFromSeries=true so later series-wide edits/deletes
  // skip it (an "exception", as in iCalendar/Google Calendar). A standalone
  // (non-recurring) event has seriesId null. See src/lib/calendar-service.ts.
  seriesId           String?
  detachedFromSeries Boolean              @default(false)
  series             CalendarEventSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([seriesId])
}

// How a recurring calendar event repeats. The weekday / day-of-month / nth
// weekday are DERIVED from the series anchor (the first occurrence's start), so
// no by-day columns are needed: MONTHLY_NTH_WEEKDAY of an anchor that falls on
// the 3rd Tuesday repeats on the 3rd Tuesday of each month.
enum CalendarRecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY_DAY_OF_MONTH
  MONTHLY_NTH_WEEKDAY
}

// The recurrence rule shared by every occurrence of a recurring event. The rule
// plus the anchor occurrence's start fully determine the generated dates
// (src/lib/calendar-recurrence.ts). `until` (inclusive end date) and `count`
// (number of occurrences) are the two supported end conditions; both null means
// "no explicit end", capped by a safety horizon at generation time.
model CalendarEventSeries {
  id          String                      @id @default(cuid())
  frequency   CalendarRecurrenceFrequency
  interval    Int                         @default(1)
  until       DateTime?
  count       Int?
  createdById String
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  events CalendarEvent[]
}

// ---------------------------------------------------------------------------
// Maintenance Reports (#2780)
//
// A member — or, on the QR path, anyone physically at the lodge — reports a
// physical fault so the maintenance officer hears about it without a phone call.
//
// DELIBERATELY SEPARATE FROM `IssueReport`, which is the in-app BUG report
// (pageUrl, browser info, a screenshot of the app) and is club-wide because a
// software defect has no lodge. A maintenance report is about a building, so it
// is lodge-scoped. What IS reused is that feature's proven retention shape: the
// photo lives in a `@db.Text` data URL beside a
// capturedAt/expiresAt/deletedAt/deletedById/deleteReason quartet, and the same
// cron redacts both (`src/lib/issue-report-retention.ts` and
// `src/lib/maintenance-report-retention.ts`, both driven by
// POST /api/cron/issue-reports).
//
// Lodge scoping is declared in docs/multi-lodge/lodge-scoping-contract.md:
// `MaintenanceReport` and `LodgeMaintenanceReportToken` are lodge-scoped by a
// direct NOT NULL `lodgeId`; `MaintenanceReportQuestion` and
// `MaintenanceReportSettings` are club-wide.
// ---------------------------------------------------------------------------

enum MaintenanceQuestionType {
  SHORT_TEXT
  LONG_TEXT
  YES_NO
  SINGLE_CHOICE
}

enum MaintenanceReportSource {
  MEMBER_PORTAL
  LODGE_QR
}

enum MaintenanceReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

/// Club-wide singleton. `id` is fixed to "default" like every other settings
/// singleton in this schema; every read synthesises these defaults on a miss, so
/// an upgrade that has never opened the admin section still behaves.
model MaintenanceReportSettings {
  id String @id @default("default")

  /// Master switch for the UNAUTHENTICATED per-lodge QR form. Default OFF: an
  /// endpoint anybody on the internet can post to is opt-in, never something an
  /// upgrade turns on. While it is off every lodge token answers the same
  /// generic 404 an unknown token gets, so the switch is not an oracle.
  anonymousReportsEnabled Boolean @default(false)
  /// Whether a photo may be attached at all, on either path.
  photosEnabled           Boolean @default(true)
  /// Whether a photo may be attached on the ANONYMOUS path specifically. A club
  /// can keep member photos and refuse anonymous ones without losing the QR form.
  anonymousPhotosEnabled  Boolean @default(true)
  /// Days a submitted photo and a stored submitter fingerprint are kept before
  /// the retention cron redacts them. 1-365; 30 matches the issue-report default.
  photoRetentionDays      Int     @default(30)
  /// Whether the anonymous form asks for an optional name and contact detail so
  /// the officer can follow up. Never required — the point of the QR is no login.
  anonymousContactPrompt  Boolean @default(true)

  updatedAt         DateTime @default(now()) @updatedAt
  updatedByMemberId String?
}

/// The admin-configurable question set. Club-wide by design: this is a BOUNDED
/// editor (label, type, required, order), not a form builder, and a per-lodge
/// set would double it for no stated need. Making it per-lodge later is an ADR,
/// not an edit — see docs/multi-lodge/lodge-scoping-contract.md.
///
/// Questions are never hard-deleted from the admin UI; they are deactivated, so
/// a report's answers keep pointing at the row they were asked from. The answer
/// row snapshots the label anyway (see `MaintenanceReportAnswer.questionLabel`),
/// which is what actually makes a submitted report survive a later edit.
model MaintenanceReportQuestion {
  id        String                  @id @default(cuid())
  label     String                  @db.VarChar(200)
  helpText  String?                 @db.VarChar(300)
  type      MaintenanceQuestionType @default(SHORT_TEXT)
  required  Boolean                 @default(false)
  /// Options for SINGLE_CHOICE; empty for every other type.
  choices   String[]                @default([])
  sortOrder Int                     @default(0)
  active    Boolean                 @default(true)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @default(now()) @updatedAt

  answers MaintenanceReportAnswer[]

  @@index([active, sortOrder])
}

/// One submitted report. Lodge-scoped by a direct NOT NULL `lodgeId`.
model MaintenanceReport {
  id      String                  @id @default(cuid())
  lodgeId String
  source  MaintenanceReportSource
  status  MaintenanceReportStatus @default(OPEN)

  /// The submitting member on the portal path; ALWAYS null on the QR path, which
  /// knows nothing about accounts and must never be able to name one.
  memberId String?
  /// Optional self-declared contact on the anonymous path only. Free text, never
  /// resolved against the membership roll — typing a member's name here proves
  /// nothing and grants nothing.
  reporterName    String? @db.VarChar(120)
  reporterContact String? @db.VarChar(200)

  summary String @db.VarChar(200)

  /// Photo, stored exactly like an issue-report screenshot: one base64 data URL,
  /// redacted in place by the retention cron rather than deleting the report.
  photoDataUrl      String?   @db.Text
  photoContentType  String?   @db.VarChar(40)
  photoCapturedAt   DateTime?
  photoExpiresAt    DateTime?
  photoDeletedAt    DateTime?
  photoDeletedById  String?
  photoDeleteReason String?   @db.VarChar(300)

  /// SHA-256 of the submitting IP, anonymous path only, kept for the same window
  /// as the photo and redacted by the same cron. Hashed rather than stored raw
  /// because its only job is "were these the same source", which equality
  /// answers without keeping an address.
  submitterIpHash          String?   @db.VarChar(64)
  submitterIpHashExpiresAt DateTime?
  submitterIpHashDeletedAt DateTime?

  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?   @db.VarChar(1000)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  lodge   Lodge                     @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  member  Member?                   @relation("MaintenanceReportReporter", fields: [memberId], references: [id], onDelete: SetNull)
  answers MaintenanceReportAnswer[]

  @@index([lodgeId, status, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([memberId, createdAt])
  @@index([photoExpiresAt])
  @@index([submitterIpHashExpiresAt])
}

/// One answer, carrying the question TEXT AS ASKED.
///
/// This is the owner's decision 2 on #2780 made structural: `questionLabel`,
/// `questionType` and `sortOrder` are SNAPSHOTS taken at submit time, so
/// renaming, reordering or retiring a question later cannot rewrite what a
/// reporter was actually asked. `questionId` is a nullable back-reference for
/// reporting only and is deliberately not load-bearing.
model MaintenanceReportAnswer {
  id            String                  @id @default(cuid())
  reportId      String
  questionId    String?
  questionLabel String                  @db.VarChar(200)
  questionType  MaintenanceQuestionType
  sortOrder     Int
  answerText    String                  @db.Text
  createdAt     DateTime                @default(now())

  report   MaintenanceReport          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  question MaintenanceReportQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([reportId, sortOrder])
  @@index([questionId])
}

/// The per-lodge QR bearer token. One live row per lodge (`lodgeId @unique`), so
/// rotating REPLACES the hash in place and the previous token stops working the
/// instant an admin rotates — which is the whole point of a rotate button.
///
/// Stored hashed (`hashActionToken`, sha256 hex) like every other bearer token
/// in this schema; the raw value is shown to the admin once at mint time and
/// lives only on the printed sign after that.
model LodgeMaintenanceReportToken {
  id        String  @id @default(cuid())
  lodgeId   String  @unique
  tokenHash String  @unique
  /// Per-lodge off switch, independent of the club-wide setting: a club can
  /// retire one lodge's sign without disabling the QR path everywhere.
  active    Boolean @default(true)

  createdAt   DateTime  @default(now())
  createdById String?
  rotatedAt   DateTime?
  rotatedById String?
  lastUsedAt  DateTime?

  lodge Lodge @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
}

/// The installation's environment-safety override (ENV-SAFETY 1, #3034; epic
/// #2986). One row, id "default", exactly like ClubTimeSettings and every other
/// settings singleton.
///
/// THE SHAPE IS THE GUARANTEE, not the code above it. There is deliberately NO
/// column here that can assert "this instance IS production": the only lever is
/// `forceNonProduction`, and the only direction it moves the answer in is
/// towards the safer non-production state. An operator who has to make a copy of
/// production safe can do it from inside the app; nobody — not an admin, not a
/// restored database, not a hand-written UPDATE — can make an instance claim to
/// be production from in here. Production is declared by the DEPLOYMENT
/// (`APP_ENVIRONMENT_ROLE`) and by nothing else. Adding an `isProduction`,
/// `forceProduction` or `role` column to this model would remove that
/// structural guarantee and turn INV-CONFIG-003 back into a convention; the
/// no-elevation test reads this model out of the Prisma DMMF and fails if such a
/// field appears.
///
/// THE ROW IS NOT SEEDED. Absent means "no override", which is the same answer
/// as `forceNonProduction = false`, so a read path never has to create anything.
model EnvironmentSafetySettings {
  id String @id @default("default")

  /// When true, this installation resolves NON_PRODUCTION whatever the
  /// deployment declares. When false (or when no row exists) the deployment
  /// declaration decides — which is not an elevation: an undeclared
  /// installation goes back to UNKNOWN, never to production.
  forceNonProduction Boolean @default(false)

  updatedByMemberId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([updatedByMemberId])
}

/// Proof that one Xero contact's stored email address has been CONTAINED on this
/// installation (ENV-SAFETY 3, #3036; epic #2986; INV-CONFIG-005).
///
/// WHY THE PROOF HAS TO BE DURABLE. A copy restored from the club's live
/// database arrives with every member already linked to a real Xero contact, so
/// `findOrCreateXeroContact` returns from its steady-state fast path without
/// ever looking at what that contact holds. Xero then emails its own invoice
/// reminders, from its own servers, to the address stored on the contact — with
/// no API call from this application at all. So a copy has to KNOW, before it
/// raises an invoice, that the contact it is invoicing can no longer reach a
/// member; and it has to know it without asking Xero once per invoice.
///
/// ONE ROW PER XERO CONTACT, and deliberately NOT per member. Containment is a
/// property of the provider-side contact, not of the person: two members can
/// never share a contact (the link writers refuse it), a contact can outlive the
/// member it was linked to, and a member merge moves a link without changing
/// what Xero holds. Keying on the contact also means there is no `memberId`
/// column here for a merge or a deletion sweep to have an opinion about.
///
/// `containedEmail` IS THE FINGERPRINT, not a second copy of anything. It is the
/// contained address this application derives from the member's current stored
/// address — a SHA-256 of that address on the reserved `.invalid` domain, so it
/// identifies the source address without carrying it, and an operator surface
/// can report containment without exposing a member's real email. The fast path
/// requires it to MATCH what the application would write today: if the member's
/// address has moved since, the row no longer describes the address we would
/// put on this contact, so the application re-reads the contact from Xero
/// instead of trusting a claim made before the change. That is the whole reason
/// a bare "this contact is contained" boolean was rejected.
///
/// `rewroteAddress` records whether Xero was actually holding a deliverable
/// address that this installation overwrote, as opposed to a contact that was
/// already unreachable (blank, or a club-internal walk-in/deleted placeholder).
/// It is what lets the operator surface say how much real accounting data a copy
/// has rewritten, which is the number somebody wants when they discover a copy
/// was pointed at the club's real Xero organisation.
///
/// PRODUCTION NEVER WRITES A ROW HERE. Containment runs only on a confirmed
/// NON_PRODUCTION installation, so on the club's live site this table stays
/// empty for ever — which is also why an empty table is not evidence of anything
/// on its own and every surface shows the effective role beside the count.
///
/// NOTHING EVER DELETES A ROW, and that is a decision rather than an omission
/// (#3036 review P2-18). A row for a Xero contact that has since been archived,
/// deleted in Xero, or unlinked from every member is still a true record that
/// THIS installation edited that contact in the club's accounting, and it is
/// exactly the record somebody wants when they discover the copy was pointed at
/// the real organisation. A sweep that tidied it away would delete the evidence
/// and quietly reduce the number the operator surface reports — the
/// reassuring-false-record shape this whole epic is about.
///
/// THE BOUND IS THEREFORE THE NUMBER OF CONTACTS A COPY HAS EVER RESOLVED, one
/// row each, upserted. On the largest club that is thousands of narrow rows, not
/// a log, and it grows only when the copy meets a contact it has not met before.
/// A copy that has finished with a Xero organisation is thrown away with its
/// database; there is no long-lived installation for this to accumulate on.
model XeroSandboxContactContainment {
  id String @id @default(cuid())

  /// The Xero contact this row is about. Unique: one contact, one containment
  /// record, upserted rather than appended, so the table cannot grow per
  /// invoice.
  xeroContactId String @unique

  /// The contained address derived from the member's stored address at the
  /// moment containment was last verified. See the model comment: this is the
  /// staleness fingerprint, not decoration.
  containedEmail String

  /// True when Xero was holding a deliverable address and this installation
  /// replaced it; false when the contact was already unreachable and nothing
  /// was written to the provider.
  ///
  /// MONOTONE: it goes false -> true and never back. A re-verification finds the
  /// contained address already in place and would otherwise recompute this as
  /// `false`, silently retracting the record of a real address this installation
  /// really did overwrite — and the operator surface would then positively
  /// assert that nothing was overwritten. The writer omits the column from its
  /// update rather than setting it to `false`.
  rewroteAddress Boolean

  /// When containment was first established for this contact, and when it was
  /// last re-verified. Both, because "we have been containing this contact
  /// since June" and "we last checked five minutes ago" are different operator
  /// questions, and both are read: the operator surface reports the earliest
  /// `containedAt` and the latest `updatedAt`.
  ///
  /// `updatedAt` IS ALSO THE PROOF'S AGE, which is what bounds how long a
  /// provider-side change can go unnoticed. Nothing this application does can
  /// invalidate a proof from the Xero side — somebody editing the contact in
  /// Xero, or the live site pushing the member's real address back onto it — so
  /// the fast path additionally requires the proof to be younger than
  /// `XERO_CONTAINMENT_PROOF_MAX_AGE_MS` and re-reads the contact past that.
  containedAt DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  /// When a DELIVERABLE address was last actually replaced on this contact, or
  /// `null` if one never was.
  ///
  /// Separate from `updatedAt`, which moves on every re-verification. The
  /// operator question behind the urgent number is "when did this copy last edit
  /// the club's real books", and answering it with the most recent re-check
  /// would date the damage to whenever the copy last ran anything at all.
  rewrittenAt DateTime?
}
