  // zero change until an admin turns it on. Safe to add as a defaulted column
  // because every read narrows to CLUB_MODULE_SETTINGS_COLUMN_SELECT. In this
  // release the flag is inert: no booking path reads it, so turning it ON
  // changes no outcome at any of the seven resolveLinkedBookingMembers call
  // sites (the refusal is gated on MEMBER_GUEST_WIDENING_ENABLED instead). The
  // one thing it does change is the Modules card, which reports
  // "Not available yet" rather than "Enabled" (D-17). The behaviour arrives in
  // MG2 (#2307).
  memberGuests            Boolean  @default(false)
  // AI Diagnostics (AID-2, #2371, epic #2369). Default OFF: a separate admin-only
  // paid product from the page-help aiAssistant above. Safe to add as a defaulted
  // column because every read narrows to CLUB_MODULE_SETTINGS_COLUMN_SELECT, so a
  // previously deployed client never names it. Turning it on does NOT by itself
  // enable any spend — the deployment must also configure a DEDICATED Anthropic
  // API key and a positive monthly budget (fail-closed readiness). This flag
  // deliberately does NOT travel in config-transfer bundles (see the `excluded`
  // note in config-transfer/categories/club-settings.ts) — enabling a paid,
  // separately-keyed product is a per-deployment decision like magicLink/googleLogin.
  aiDiagnostics           Boolean  @default(false)
  // Maintenance reports (#2780). Default ON: a general-purpose module with no
  // external-account or inventory prerequisite, so it follows the memberNotices
  // / eventsCalendar precedent rather than the capability-module one. Safe to
  // add as a defaulted column because every read narrows to
  // CLUB_MODULE_SETTINGS_COLUMN_SELECT, so a previously deployed client never
  // names it. Turning it ON does NOT open the unauthenticated QR form — that is
  // a separate, default-OFF switch on MaintenanceReportSettings, because an
  // endpoint anybody can post to must be opted into deliberately.
  maintenanceReports      Boolean  @default(true)
  // Alpine Central Server (ServerNZ) integration — connect this club to the
  // central hub to upload/download shared data. Off by default; configured
  // under Admin → Integrations → Alpine Central Server.
  alpineCentralServer     Boolean  @default(false)
  // Communication Portal (#2993, epic #2992). Default OFF, deliberately
  // inverting the memberNotices precedent above: a member post shared from this
  // module leaves the club and reaches every other connected club, so an
  // upgrade must not start publishing member-written content because nobody
  // opted out. The local board alone needs no central-server connection; only
  // sharing does. Safe to add as a defaulted column because every read narrows
  // to CLUB_MODULE_SETTINGS_COLUMN_SELECT, so the previously deployed client
  // never names it.
  commsPortal             Boolean  @default(false)
  updatedByMemberId       String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt

  @@index([updatedByMemberId])
}

// A physical lodge property. Every deployment has at least one row (seeded by
// migration/seed). Multi-lodge is core (ADR-005): the Lodges admin UI is always
// available (no module flag), and booking data scopes to this table. While
// exactly one active lodge exists the per-page lodge selectors auto-resolve to
// it (ADR-002 presentation rule); the vestigial ClubModuleSettings.multiLodge
// column is retired in a follow-up (#129).
model Lodge {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  active     Boolean  @default(true)
  // Durable default-lodge marker (#1656/#1627 option b): getDefaultLodgeId()
  // and the default_lodge_id() SQL function resolve the club default from this
  // flag instead of earliest-createdAt ordering (which inverts on TZ-skewed
  // seeds). At most one lodge is default, enforced by the partial unique index
  // "Lodge_isDefault_key" (WHERE "isDefault") created in migration
  // 20260709120000 — a raw partial index Prisma cannot express in-schema (same
  // pattern as XeroSyncOperation_active_correlationKey_unique). To change the
  // default, unset the current one and set the new one in a single transaction.
  isDefault  Boolean  @default(false)
  doorCode   String?  @db.VarChar(80)
  travelNote String?
  // Postal / physical address of the lodge, admin-editable (E3 #1929). Feeds the
  // {{lodge-address}} content placeholder and the public contact page's lodge block.
  // Nullable: fresh installs seed no address (the seed-account-defaults guard
  // keeps geography out of seeds); the additive migration backfills only the
  // existing default lodge with the historical hardcoded string.
  address    String?  @db.VarChar(300)
  // Per-lodge config glob for the lobby display's {{config:<key>}}
  // placeholders (docs/lobby-display/design.md §3, fork issue #26): free-form
  // string key/value pairs, validated at the admin edit surface. Null = none.
  displayConfig Json?
  // Per-lodge override of the lobby display name granularity (fork issue
  // #28, design.md §10). Null = the club-wide code default
  // (FIRST_NAME_SURNAME_INITIAL). Enum defined with the lobby-display
  // models at the end of this file.
  displayNameGranularity DisplayNameGranularity?
  // Committee notice board for the lobby display (fork issue #36): the one
  // deliberately AUTHORED display surface — free text, admin-edited,
  // rendered as text nodes only ({{config:<key>}} placeholders resolve
  // inside it). Null = no notice.
  displayNotice          String?  @db.VarChar(2000)
  // Per-lodge toggle: show guest phone numbers on this lodge's screens (kiosk +
  // lobby display), default OFF (#37/#124). Combined with the per-member opt-in
  // and an adults-only rule, enforced in the serving serialisers.
  showGuestPhonesOnScreens Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // lodgeId is nullable on these tables during the expand release
  // (docs/multi-lodge/implementation-plan.md phase 2); a contract release
  // enforces NOT NULL and per-lodge uniqueness once every writer sets it. The
  // policy tables (CancellationPolicy, BookingPeriod, MinimumStayPolicy) stay
  // permanently nullable: null rows are the club-wide defaults (ADR-001).
  rooms                    LodgeRoom[]
  lockers                  Locker[]
  seasons                  Season[]
  bookings                 Booking[]
  choreTemplates           ChoreTemplate[]
  cancellationPolicies     CancellationPolicy[]
  bookingPeriods           BookingPeriod[]
  minimumStayPolicies      MinimumStayPolicy[]
  adultMemberHostingPolicy AdultMemberHostingPolicy[]
  hutLeaderAssignments     HutLeaderAssignment[]
  memberAccess             MemberLodgeAccess[]
  promoCodes               PromoCodeLodge[]
  waitlistOfferedBookings  Booking[]                       @relation("BookingWaitlistOfferedLodge")
  waitlistAlternateEntries BookingWaitlistAlternateLodge[] @relation("WaitlistAlternateLodge")
  workPartyEvents          WorkPartyEvent[]
  instructions             LodgeInstruction[]
  bookingRequests          BookingRequest[]
  displayDevices           LodgeDisplayDevice[]
  noticeAudiences          NoticeAudience[]
  // #2525: provisional per-night bed reservations held by HELD policy-exception
  // change requests at this lodge. RESTRICT (below), so a lodge with live
  // reservations cannot be deleted out from under the capacity view.
  policyExceptionReservationNights PolicyExceptionReservationNight[] @relation("PolicyExceptionReservationLodge")
  newBookingPolicyExceptionRequests NewBookingPolicyExceptionRequest[]
  // #2780 maintenance reports: both are lodge-scoped by a direct NOT NULL
  // lodgeId, and both CASCADE — a deleted lodge takes its fault history and its
  // QR token with it, because neither means anything without the building.
  maintenanceReports      MaintenanceReport[]
  maintenanceReportToken  LodgeMaintenanceReportToken?
}

// Registry of EXTERNAL / partner lodges the club recognises (e.g. for the
// reciprocal "other club member" rate), admin-curated on Admin -> Lodges.
// Deliberately DISTINCT from the club's own Lodge rows above: an OtherLodge has
// no slug, no booking capacity, no scoping, and no relations. `bedCapacity`
// here is INFORMATIONAL only (a fact about the partner lodge) and is never this
// system's booking capacity — that is derived from Lodge rooms/beds. `name` is
// unique because it will populate a non-member "which lodge are you a member
// of" drop-down (follow-up). An admin removes a lodge from the list by deleting
// it (there is no active/inactive state — that was dropped as unneeded).
model OtherLodge {
  id                  String   @id @default(cuid())
  name                String   @unique
  location            String?  @db.VarChar(300)
  bookingOfficerName  String?  @db.VarChar(200)
  bookingOfficerEmail String?  @db.VarChar(320)
  bookingOfficerPhone String?  @db.VarChar(50)
  bedCapacity         Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  bookingRequests     BookingRequest[]
  bookings            Booking[]
}

// Alpine Central Server (ServerNZ) connection — non-secret settings only. The
// API key is NOT here; it lives in the encrypted IntegrationCredential store
// (provider "servernz"). Singleton row keyed on the fixed id "default", mirroring
// LodgeSettings. Per-shared-item enable flags and last-sync bookkeeping live
// here so the setup page can render status without touching the secret store.
model ServerNzSettings {
  id      String  @id @default("default")
  // Base URL of the central server, e.g. https://central.alpineclub.nz
  baseUrl String? @db.VarChar(500)

  // Shared item: "Other Clubs" details (the OtherLodge registry).
  otherLodgesEnabled        Boolean   @default(false)
  otherLodgesLastUploadAt   DateTime?
  otherLodgesLastDownloadAt DateTime?
  // Opaque cursor returned by the server's pull endpoint for incremental sync.
  otherLodgesCursor         String?   @db.VarChar(64)

  // Single-flight claim for a sync pass. The nightly cron and the admin
  // Upload/Download buttons drive the same writers, and the in-process boolean in
  // instrumentation.node.ts sees neither a second container nor the HTTP cron
  // route. A status-guarded `updateMany` on this column is the claim (the house
  // pattern), which needs no advisory lock: a session-scoped lock cannot be used
  // safely here because Prisma pools connections and the unlock could land on a
  // different one, and an xact-scoped lock would mean holding a transaction open
  // across the central server's HTTP calls.
  otherLodgesSyncStartedAt DateTime?

  // Shared item: the cross-club message board (epic #2992). The cursor is the
  // pair the server's /api/v1/feed/sync hands back — an updatedAt instant plus
  // a tiebreak id — stored as strings because it is THEIR cursor, not a value
  // this install computes or compares. Null means "never synced": the first
  // pull is a full sync of visible posts, which is exactly what a new install
  // wants (no backlog of tombstones for posts it never held).
  commsCursorSince   String?   @db.VarChar(64)
  commsCursorSinceId String?   @db.VarChar(64)
  // Single-flight claim for a sync pass, same pattern and same reasoning as
  // otherLodgesSyncStartedAt above: the webhook, the cron and a manual pull all
  // drive the same writer.
  commsSyncStartedAt DateTime?
  commsLastSyncAt    DateTime?
  // Poison-change tracking for the mirror ingest (#3091 review 2). A change
  // that throws stops the pass BEFORE the cursor advances, so the same change
  // is retried next pass; these record which change is failing and how many
  // consecutive passes it has failed. At the third failure the ingest steps
  // OVER it (logged as an error) so one bad row from the central server
  // cannot wedge every club's mirror sync permanently. Cleared whenever a
  // pass applies its page cleanly.
  commsPoisonChangeId String?  @db.VarChar(64)
  commsPoisonCount    Int      @default(0)

  updatedByMemberId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([updatedByMemberId])
}

model LodgeSettings {
  id                     String   @id @default("default")
  capacity               Int?
  hutLeaderLookaheadDays Int      @default(14)
  // Per-lodge school-group soft cap (the bed count above which a school
  // group needs a club member to host). Null falls back to the code
  // default. Per-lodge like capacity; resolves via the default lodge in a
  // single-lodge club (ADR-002). Warning-only — the hard limit stays the
  // lodge's capacity.
  schoolGroupSoftCap     Int?
  // Soft link to the lodge this settings row belongs to. Becomes the row key
  // when singleton settings convert to per-lodge rows (phase 7); until then
  // the "default" row keeps serving the sole lodge.
  lodgeId                String?
  updatedByMemberId      String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  @@index([updatedByMemberId])
}

// ---------------------------------------------------------------------------
// Email Message Configuration
// ---------------------------------------------------------------------------

model EmailMessageSetting {
  id                String   @id @default("default")
  clubName          String?
  bookingsName      String?
  emailFromName     String?
  supportEmail      String?
  contactEmail      String?
  publicUrl         String?
  updatedByMemberId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([updatedByMemberId])
}

// DB-first club identity (E3 #1929). Admin-editable singleton (id="default")
// holding the club-configurable identity fields; club.json remains the
// per-field fallback and hard defaults are the last resort. Every field is
// nullable so an empty/absent row is fully functional via the fallback chain
// (DB -> club.json -> hard default), resolved in src/lib/club-identity-settings.ts.
// The lodge display name is NOT stored here — it resolves from the Lodge table
// (default lodge) so identity stays a single source of truth.
model ClubIdentitySettings {
  id                String   @id @default("default")
  name              String?
  shortName         String?
  hutLeaderLabel    String?
  facebookUrl       String?
  updatedByMemberId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([updatedByMemberId])
}

// The installation's ONE club timezone (CT-1, #2989; epic #2988). Admin-editable
// singleton (id="default") holding the IANA identifier — `Pacific/Auckland`, not
// `NZT` and never a fixed offset — that is the sole civil-time authority for this
// club: every user-visible date and time is club time, and no viewer's browser,
// no container `TZ` and no database session zone changes a business answer.
//
// WHY ITS OWN MODEL rather than a column on ClubIdentitySettings. There is no
// general installation-configuration singleton in this schema; the house pattern
// is one domain-scoped `id @default("default")` settings model per configuration
// domain, and this is that pattern, not a parallel general store.
// ClubIdentitySettings is the club's BRANDING identity (name, short name,
// hut-leader label, Facebook URL): it is gated on `content:edit`, every column is
// a NULLABLE override over a live `club.json` fallback, and nothing backfills it
// from the environment. The club timezone is the opposite on all four counts —
// Full-Admin-only, NON-NULL once written, authoritative OVER the environment, and
// seeded from it exactly once — and sharing a row would also make that row's
// `updatedByMemberId`/`updatedAt` report the wrong actor for whichever surface
// wrote last.
//
// `timeZone` carries no `@default`. The ROW's existence is the "configured"
// signal: a row exists only once a validated IANA identifier has been written by
// setup, by the Full-Admin maintenance surface, by the seed, or by the boot-time
// environment backfill (`clubTimeZoneSelfHealStep` in src/lib/config-self-heal.ts,
// which runs even when `config/club.json` is absent because the value it copies
// comes from the environment, not from that file). A SQL migration cannot read
// `process.env.TZ`, so backfilling an existing deployment's CURRENT EFFECTIVE zone
// has to happen at boot — which is why no default is invented here.
// Reads/writes resolve through src/lib/club-time-zone-settings.ts; the validator
// is src/lib/club-time-zone.ts. INV-CONFIG-002.
model ClubTimeSettings {
  id                String   @id @default("default")
  timeZone          String   @db.VarChar(64)
  updatedByMemberId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([updatedByMemberId])
}

// Club-wide login & security policy singleton (epic #2030, child #2033). Mirrors
// the BookingDefaults / ClubModuleSettings / ClubIdentitySettings singleton
// pattern (one row, id "default"). Governs the password-complexity rules applied
// wherever a member CHOOSES a password (reset-password / change-password). An
// absent row means "today's behaviour": min length 12, no required character
// classes (loadLoginSecuritySettings() supplies these code defaults, so no
// SELF_HEAL/backfill is needed). magicLinkTtlMinutes is landed here for the
// sibling magic-link issue (#2034) to consume — no reader exists in #2033.
model LoginSecuritySetting {
  id                  String   @id @default("default")
  minPasswordLength   Int      @default(12)
  requireUppercase    Boolean  @default(false)
  requireLowercase    Boolean  @default(false)
  requireDigit        Boolean  @default(false)
  requireSymbol       Boolean  @default(false)
  magicLinkTtlMinutes Int      @default(15)
  updatedByMemberId   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([updatedByMemberId])
}

// Club-wide Google Analytics configuration singleton (#2573). The DATABASE is the
// sole canonical source: NEXT_PUBLIC_GA_MEASUREMENT_ID was removed from runtime
// entirely in the same change (owner-accepted hard cutover), so analytics stays
// inactive after that deploy until an admin saves a valid measurement ID under
// Admin -> Integrations. An absent row means "not configured": every reader
// synthesises the code defaults on a miss and fails closed, so no seed is needed.
//
// measurementId is nullable because "no ID yet" is the shipped state, not an error.
// It is ordinary CONFIGURATION rather than a confidential value — it is published in
// the page source of every page GA runs on — so it is stored in plain text here
// rather than in the encrypted integration vault, and it is still behind the finance
// area's admin read and edit permissions like every other integration setting.
// (Worded without the words the admin-modules schema contract test forbids across
// this whole region of the file; see src/lib/__tests__/admin-modules-api.test.ts.)
//
// consentRevision is the visitor-facing re-consent counter. It is bumped ONLY by
// the explicit "Ask visitors to choose again" admin action, never as a side effect
// of an ordinary Save (owner decision section 6): visitors store their choice
// together with the revision it was made under, so a bump invalidates every prior
// banner-mode choice and re-prompts. Ordinary wording edits must not reset consent.
//
// updatedByMemberId is a PLAIN STRING with NO foreign key (audit-only), the same
// shape every other settings singleton uses.
model AnalyticsSettings {
  id                   String   @id @default("default")
  measurementId        String?
  consentBannerEnabled Boolean  @default(true)
  bannerMessage        String?
  consentRevision      Int      @default(1)
  updatedByMemberId    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  @@index([updatedByMemberId])
}

model EmailTemplateOverride {
  id                String   @id @default(cuid())
  templateName      String   @unique
  subject           String?
  // With a rich body (below), bodyText is DERIVED on save — the block-aware
  // text extraction of bodyHtml — so audit rows, diffs, stale-content
  // comparison and token validation keep operating on text. For legacy rows
  // it remains the authored body and the render source.
  bodyText          String?
  // Fork #38 (owner decision, 25 Aug 2026): the rich-editor body, sanitised
  // against the email policy BEFORE storage. Null for every row saved before
  // the feature — those keep rendering through the plain-text path
  // byte-for-byte until re-saved. Additive and nullable — blue/green safe.
  bodyHtml          String?
  updatedByMemberId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([updatedByMemberId])
}


model BookingMessageOverride {
  id                String   @id @default(cuid())
  messageKey        String   @unique
  bodyText          String
  updatedByMemberId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([updatedByMemberId])
}

model InternetBankingPaymentSettings {
  id                       String   @id @default("default")
  holdBedSlots             Boolean  @default(false)
  holdDays                 Int      @default(3)
  minimumDaysBeforeCheckIn Int      @default(0)
  updatedByMemberId        String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([updatedByMemberId])
}

model PageContent {
  id                String   @id @default(cuid())
  slug              String   @unique
  path              String   @unique
  caption           String   @default("")
  menuTitle         String   @default("")
  title             String
  headerText        String   @default("")
  sortOrder         Int      @default(100)
  contentHtml       String
  published         Boolean  @default(true)
  updatedByMemberId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Back-relation for the public Book Now target (E3 #1929). SetNull on delete.
  bookNowSettings   PublicContentSettings[] @relation("PublicContentBookNowPage")

  @@index([sortOrder])
  @@index([updatedByMemberId])
}

// Discriminates what an image blob is used for (MP1, epic #171). CONTENT is the
// default and covers every pre-existing row plus admin page-content uploads,
// which are the only kind the website media picker (/api/admin/image-library)
// ever surfaces. MEMBER_PHOTO rows are member profile photos referenced by
// Member.photoImageId and are deliberately hidden from the content picker and
// served only through the scoped member-photo endpoint (never the public
// /api/images path) — see docs/member-photos/decisions/ADR-001-member-photos.md.
enum MediaImageKind {
  CONTENT
  MEMBER_PHOTO
  // #2322: club logos uploaded through the site-style wizard. Publicly served
  // like CONTENT, but kept out of the content picker (which lists CONTENT only)
  // and owned by the theme row — replacing or clearing the logo deletes exactly
  // the prior LOGO blob. A CONTENT row is never deleted that way: page HTML may
  // reference it.
  LOGO
}

// Uploaded images for the page-content image picker, stored in the database
// (rather than the filesystem) so they survive Docker redeploys. Served
// publicly via /api/images/[id].
model MediaImage {
  id                 String   @id @default(cuid())
  filename           String
  contentType        String
  byteSize           Int
  data               Bytes
  altText            String?
  width              Int?
  height             Int?
  uploadedByMemberId String?
  kind               MediaImageKind @default(CONTENT)
  createdAt          DateTime @default(now())

  // Reverse side of Member.photoImage. A MEMBER_PHOTO blob is normally the photo
  // of exactly one member, but the FK is not unique so Prisma models this as a
  // list. onDelete: SetNull lives on the owning Member.photoImage side.
  photoOfMembers Member[] @relation("MemberPhoto")

  @@index([uploadedByMemberId])
  @@index([createdAt])
  // Supports the content-picker filter (kind = CONTENT) and member-photo lookups.
  @@index([kind])
}

// Admin-managed site-wide notification banners. Displayed above the site
// header on public and member shells while today (NZ date-only) falls inside
// the banner's display window. Message is always rendered as plain text.
enum SiteBannerPriority {
  URGENT
  WARNING
  NOTIFY
}

model SiteBanner {
  id                String             @id @default(cuid())
  message           String
  priority          SiteBannerPriority
  startDate         DateTime           @db.Date
  endDate           DateTime           @db.Date
  active            Boolean            @default(true)
  createdByMemberId String?
  updatedByMemberId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([active, startDate, endDate])
}

// ---------------------------------------------------------------------------
// Member Notices / Recent News (memberNotices module)
//
// Committee/admin-authored, audience-targeted notices with per-member read
// receipts. bodyHtml is sanitised on save AND re-sanitised at render
// (defense-in-depth, sanitizePageContentHtml). Members never see audience
// definitions or other members' receipts; the single visibility predicate in
// src/lib/notices.ts (visibleNoticeWhere) gates every member-facing read so no
// caller can diverge. financialMembersOnly restricts GROUP-kind audience
// matches to paid-up/exempt (financial) members; explicit MEMBER targets always
// see the notice.
// ---------------------------------------------------------------------------

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NoticeAudienceKind {
  ALL_MEMBERS
  MEMBER
  MEMBERSHIP_TYPE
  LODGE
  COMMITTEE_ROLE
}

model Notice {
  id                      String       @id @default(cuid())
  title                   String       @db.VarChar(200)
  // Sanitised authored HTML (sanitizePageContentHtml on save; re-sanitised at
  // render). Never rendered raw.
  bodyHtml                String       @db.Text
  status                  NoticeStatus @default(DRAFT)
  // Set once, on the first DRAFT/ARCHIVED -> PUBLISHED transition; never
  // rewritten on re-publish so the member-facing publishedAt ordering is stable.
  publishedAt             DateTime?
  expiresAt               DateTime?
  pinned                  Boolean      @default(false)
  requiresAcknowledgement Boolean      @default(false)
  // When true, group-kind audience matches (ALL_MEMBERS/MEMBERSHIP_TYPE/LODGE/
  // COMMITTEE_ROLE) only reach financial (paid-up or exempt) members; explicit
  // MEMBER targets are exempt from this filter.
  financialMembersOnly    Boolean      @default(false)
  // Single-send guard for the optional email-on-publish. Set once after the send
  // batch commits; a second publish never re-emails.
  emailedAt               DateTime?
  createdByMemberId       String?
  updatedByMemberId       String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  createdBy Member? @relation("NoticeCreatedBy", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  updatedBy Member? @relation("NoticeUpdatedBy", fields: [updatedByMemberId], references: [id], onDelete: SetNull)

  audiences    NoticeAudience[]
  readReceipts NoticeReadReceipt[]

  @@index([status, publishedAt])
  @@index([createdByMemberId])
  @@index([updatedByMemberId])
}

// One audience-targeting rule for a notice. Real (not app-only) foreign keys on
// every typed target so a deleted target row Cascades the audience row away
// (fails closed — a stale id can never widen visibility). App-side dedup is via
// replace-all writes (deleteMany + createMany) inside the update transaction,
// mirroring replaceMembershipTypeRuleConfiguration.
model NoticeAudience {
  id               String             @id @default(cuid())
  noticeId         String
  kind             NoticeAudienceKind
  memberId         String?
  membershipTypeId String?
  lodgeId          String?
  committeeRoleId  String?
  createdAt        DateTime           @default(now())

  notice         Notice          @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  member         Member?         @relation("NoticeAudienceMember", fields: [memberId], references: [id], onDelete: Cascade)
  membershipType MembershipType? @relation(fields: [membershipTypeId], references: [id], onDelete: Cascade)
  lodge          Lodge?          @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  committeeRole  CommitteeRole?  @relation(fields: [committeeRoleId], references: [id], onDelete: Cascade)

  @@index([noticeId])
  @@index([memberId])
  @@index([membershipTypeId])
  @@index([lodgeId])
  @@index([committeeRoleId])
}

// Per-member read receipt. readAt is set once on first open and never
// overwritten; acknowledgedAt is set once when a member acknowledges a notice
// that requiresAcknowledgement.
model NoticeReadReceipt {
  id             String    @id @default(cuid())
  noticeId       String
  memberId       String
  readAt         DateTime  @default(now())
  acknowledgedAt DateTime?

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  member Member @relation("NoticeReadReceiptMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([noticeId, memberId])
  @@index([noticeId, readAt])
  @@index([memberId])
}

// ---------------------------------------------------------------------------
// Communication Portal (#2993, epic #2992) — the member message board.
//
// CLUB-WIDE, NOT LODGE-SCOPED (decision D-C1). A post can be shared onto a
// network of other CLUBS, which has no concept of this club's buildings, so a
// lodge on the row would have nowhere to go and nothing to mean. This matches
// ServerNzSettings, which docs/multi-lodge/lodge-scoping-contract.md records as
// club-wide for the same reason, and Notice above, which carries no lodgeId.
//
// A post written here stays here unless a member ticks "share with all clubs".
// Only then is it uploaded to the central server and mirrored to other clubs.
// A club-only post is never transmitted at all — which is a stronger guarantee
// than a visibility filter, because there is no filter to get wrong.
// ---------------------------------------------------------------------------

model ClubPost {
  id               String    @id @default(cuid())
  // NULL = written by this club. Non-null = mirrored from another club via the
  // central server, which also means the content is READ-ONLY here (D-C4):
  // editing another club's post while still showing their name and badge on it
  // would misrepresent them to our members. Hiding and removing the local copy
  // stay available and say what they actually do.
  originClubCode   String?   @db.VarChar(40)
  originClubName   String?   @db.VarChar(200)
  // Both null until shared. serverPostId is the ONLY handle by which the
  // network copy can ever be withdrawn, so it must never be cleared before the
  // central server confirms the withdrawal. Capped at 64 for the same reason
  // ServerNzSettings.otherLodgesCursor is: an over-long value fails AFTER rows
  // are written and BEFORE the cursor advances, which wedges sync permanently.
  // The member ASKED for this to go to the network. Distinct from sharedAt,
  // which means the server actually took it, and the gap between them is the
  // point: the central server can be down, mid-deploy or slow, and a post must
  // never be lost or silently kept local because of that. A request that has
  // not yet succeeded is retried by the cron; until it does, the post is live
  // on this club's own board exactly as any other.
  shareRequestedAt DateTime?
  // Why the last attempt failed, for the member and the admin screen. Cleared
  // on success. Bounded because it can carry the remote's own error text.
  shareError       String?   @db.VarChar(300)
  // How many times the share has been attempted and failed (#3091 review 5).
  // MAX_SHARE_ATTEMPTS in club-post-sharing.ts is the cap: at the cap the
  // request is cleared with the reason on shareError, so eight permanently
  // failing posts cannot occupy the sweep's page forever — and the sweep
  // selects fewest-attempts-first, so a stuck head cannot starve newer posts.
  shareAttempts    Int       @default(0)
  sharedAt         DateTime?
  serverPostId     String?   @unique @db.VarChar(64)
  // The central server CONFIRMED the takedown of this club's own shared post
  // (#3091 review 1). Null with removedAt set and serverPostId present means
  // the network copy may still be visible to other clubs: the withdrawal
  // sweep retries it each cycle and the moderation screen names it until this
  // is stamped. Only ever set on posts this club authored (originClubCode
  // null) — removing a MIRROR is a local act with nothing to withdraw.
  withdrawnAt      DateTime?
  // Taken from the authenticated session at compose time, never from a form
  // field. The central server cannot verify author identity — it trusts this
  // club's API key — so that trust is only warranted if the value is a real
  // session here. SetNull rather than Cascade: a post survives the member
  // record going away, exactly as Notice.createdByMemberId does.
  authorMemberId   String?
  authorName       String    @db.VarChar(200)
  // The plain-text form. Still authoritative: it is what search matches, what
  // the dashboard card and moderation list show, and what a consumer that
  // cannot render HTML falls back to. Never HTML, and never rendered as HTML.
  content          String    @db.VarChar(4000)
  // The rich form the WYSIWYG composer writes, SANITISED ON WRITE against the
  // allowlist in post-html.ts and sanitised again on render. Null for every
  // post written before the editor existed, and for anything whose HTML
  // sanitised down to nothing — `content` covers both, which is why this is
  // additive rather than a replacement (mirrors Notice.bodyHtml).
  //
  // Larger than `content` because the same words carry markup: 4000 characters
  // of text with headings, alignment and colour does not fit in 4000 bytes.
  bodyHtml         String?   @db.VarChar(20000)
  postedAt         DateTime  @default(now())
  // Hidden is reversible with the content intact; removed is not. Both are
  // local-only decisions and neither reaches another club.
  hiddenAt         DateTime?
  removedAt        DateTime?
  // Cached count of non-dismissed reports, recomputed from the rows rather than
  // incremented, so a dismissal actually stops counting.
  reportCount      Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  author  Member?          @relation("ClubPostAuthor", fields: [authorMemberId], references: [id], onDelete: SetNull)
  images  ClubPostImage[]
  reports ClubPostReport[]

  @@index([postedAt])
  @@index([originClubCode])
  @@index([sharedAt])
  @@index([shareRequestedAt])
  @@index([authorMemberId])
}

model ClubPostImage {
  id                 String    @id @default(cuid())
  // NULL until the post is submitted. A member picks an image while still
  // typing, so the file exists before the post does; the composer claims these
  // rows on submit. An image nobody ever claims is swept by the retention job
  // rather than lingering as an orphan on the mount.
  postId             String?
  post               ClubPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Who uploaded it. A BARE SCALAR with no @relation, exactly like
  // MediaImage.uploadedByMemberId: it is the audit answer to "who put this
  // here", so a member merge leaves it pointing at the id that actually did.
  // It is also the only attribution an unclaimed upload has, since there is no
  // post to ask.
  uploadedByMemberId String?
  // Path relative to the configured upload root, never absolute and never
  // client-supplied.
  storageKey         String    @db.VarChar(300)
  // What the serving route takes, so a storage key never appears in a URL and
  // one image's address cannot be derived from another's.
  publicId           String    @unique @db.VarChar(64)
  // Sniffed from the file's own leading bytes on upload, never from the name
  // or the browser-supplied type, and echoed back as the Content-Type.
  mimeType           String    @db.VarChar(40)
  // Of the stored bytes. Lets a shared copy be matched to its origin without
  // re-uploading, and makes a truncated write detectable.
  sha256             String    @db.VarChar(64)
  // Nullable: dimensions are read opportunistically and a format this
  // deployment cannot measure must not block a member's post.
  width              Int?
  height             Int?
  bytes              Int
  position           Int       @default(0)
  createdAt          DateTime  @default(now())

  @@index([postId])
}

model ClubPostReport {
  id       String   @id @default(cuid())
  postId   String
  post     ClubPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Single-club, so unlike the central server's equivalent table the uniqueness
  // key needs no club: member ids are unique within this deployment.
  reporterMemberId String?
  reporterName     String   @db.VarChar(200)
  reason           ClubPostReportReason
  details          String?  @db.VarChar(1000)
  // Stamped rather than deleted when an admin dismisses, so the history stays
  // visible to the next admin and the post remains re-reportable by a fresh set
  // of members. Zeroing a counter while these rows stayed would do neither.
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  reporter Member? @relation("ClubPostReporter", fields: [reporterMemberId], references: [id], onDelete: SetNull)

  @@unique([postId, reporterMemberId])
  @@index([postId])
  @@index([reporterMemberId])
}

// Retention and cleanup policy for the club message board (#2999, epic #2992).
// A singleton, like MaintenanceReportSettings: this is a club decision, not a
// per-lodge one, for the same reason ClubPost itself carries no lodge (D-C1).
model ClubPostSettings {
  id String @id @default("default")

  /// Days a post is kept before the cleanup pass deletes it permanently.
  /// DEFAULT 0 = KEEP EVERYTHING, and that default is load-bearing: an upgrade
  /// must never begin destroying member content because a default said so.
  /// A club chooses a window deliberately (INV-CONFIG-001).
  retentionDays Int @default(0)

  /// Single-flight claim for the cleanup pass, held while one runs.
  ///
  /// A status-guarded claim rather than a Postgres advisory lock, for the
  /// reason src/lib/servernz-sync-claim.ts sets out at length: a session-scoped
  /// advisory lock is taken and released through Prisma's connection POOL, so
  /// the unlock can execute on a different connection and wedge the job until
  /// the pool recycles. An xact-scoped lock would mean holding a transaction
  /// open across the whole pass. A conditional update whose matched-row count
  /// IS the claim has neither problem, and a process killed mid-pass is reaped
  /// by staleness rather than by a sweeper.
  cleanupStartedAt DateTime?

  /// When the last pass finished, and what it deleted, so the admin screen can
  /// say what happened without keeping a separate history.
  lastCleanupAt      DateTime?
  lastCleanupDeleted Int       @default(0)

  updatedAt         DateTime @default(now()) @updatedAt
  updatedByMemberId String?
}

enum ClubPostReportReason {
  SPAM
  INAPPROPRIATE
  HARASSMENT
  OTHER
}


enum NotificationDeliveryMode {
  ALWAYS
  CONTENT_ONLY
  DISABLED
}

model NotificationDeliveryPolicy {
  id                String                   @id @default(cuid())
  templateName      String                   @unique
  mode              NotificationDeliveryMode @default(ALWAYS)
  updatedByMemberId String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([updatedByMemberId])
  @@index([mode])
}

// ---------------------------------------------------------------------------
// Membership Cancellation Configuration
// ---------------------------------------------------------------------------

model MembershipCancellationSetting {
  id                                String   @id @default("default")
  warningText                       String?
  rejoinProcessText                 String?
  xeroArchiveContactsOnCancellation Boolean  @default(false)
  updatedByMemberId                 String?
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  xeroContactGroups MembershipCancellationXeroContactGroup[]

  @@index([updatedByMemberId])
}

model MembershipCancellationXeroContactGroup {
  id        String   @id @default(cuid())
  settingId String   @default("default")
  groupId   String
  groupName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setting MembershipCancellationSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  @@unique([settingId, groupId])
  @@index([settingId])
  @@index([groupId])
}

// ---------------------------------------------------------------------------
// Booking Modifications (history of changes to bookings)
// ---------------------------------------------------------------------------

model BookingModification {
  id               String   @id @default(cuid())
  bookingId        String
  memberId         String
  modificationType String // DATE_CHANGE | GUEST_ADD | GUEST_REMOVE | EXTEND_STAY
  previousData     Json // snapshot of changed fields before
  newData          Json // snapshot of changed fields after
  priceDiffCents   Int      @default(0) // positive = owes more, negative = refund
  changeFeeCents   Int      @default(0) // late-notice fee charged
  createdAt        DateTime @default(now())

  booking                 Booking                @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  linkedChangeRequests    BookingChangeRequest[] @relation("BookingChangeRequestLinkedModification")
  creditsFromModification MemberCredit[]         @relation("CreditSourceModification")

  @@index([bookingId])
  @@index([memberId])
}

// Booking Change Requests (locked same-day/past-night edits needing admin review)
model BookingChangeRequest {
  id                   String                     @id @default(cuid())
  bookingId            String
  requestedByMemberId  String
  status               BookingChangeRequestStatus @default(REQUESTED)
  // #2365: LOCKED_PERIOD (the original today/past-night edit) or POLICY_EXCEPTION
  // (a member request to override an eligible soft booking-policy failure). The
  // default keeps every pre-#2365 row and every locked-period writer unchanged.
  kind                 BookingChangeRequestKind   @default(LOCKED_PERIOD)
  requestedChanges     Json
  reason               String?                    @db.VarChar(2000)
  // MEMBER-VISIBLE, on BOTH kinds of row. The officer's decision explanation,
  // written FOR the member and rendered to them on their own request list, on
  // their booking page under "Change Requests" (the LOCKED_PERIOD half), in the
  // approval and refusal emails, and in the exception API payloads (#2562). Never
  // treat this as a private field: every officer UI that writes it labels it as
  // member-visible before the decision is submitted, and `internalNotes` below is
  // the field for anything they do not want read.
  adminNotes           String?                    @db.VarChar(2000)
  // #2562: NEVER MEMBER-VISIBLE. The officer's private commentary on the
  // decision — a judgement about the member, a reference to another member's
  // booking, a "watch this one" for the next officer. Read ONLY by admin-guarded
  // surfaces (the officer queue and its detail endpoint). No member-facing
  // projection, route select, email template or notification may name it; the
  // member DTO in src/lib/member-exception-requests.ts is a strict allowlist
  // that has no slot for it, and INV-REQ-003 in
  // docs/invariants/booking-requests.md records the rule.
  internalNotes        String?                    @db.VarChar(2000)
  reviewedByMemberId   String?
  reviewedAt           DateTime?
  linkedModificationId String?
  // --- #2365 policy-exception evidence (all null on a LOCKED_PERIOD row) ---
  // The complete, IMMUTABLE proposal the member is asking an admin to allow —
  // the full proposed booking snapshot (new-booking shape) or the full
  // proposed-vs-live delta (modification shape). Frozen at submit time; never
  // rewritten. `proposalHash` is the canonical SHA-256 over that snapshot plus
  // the base facts, so approval can detect that what it is about to execute is
  // byte-for-byte what was reviewed (proposal drift).
  proposalSnapshot     Json?
  proposalHash         String?                    @db.VarChar(64)
  // The frozen AggregatedPolicyExceptions: every covered structured violation
  // (reason code, policy id/version, resolved scope, affected NZ nights,
  // requirements, per-policy capacity mode) plus the HOLD-if-any-HOLD aggregate.
  // Authoritative for what an approval may override — and for nothing else.
  frozenEvidence       Json?
  // Denormalised HOLD-if-any-HOLD aggregate so the queue and the capacity path
  // filter without parsing `frozenEvidence`. Null on a locked-period row.
  aggregateCapacityMode PolicyExceptionCapacityMode?
  // Required, trimmed, <=1000 chars on a policy-exception request; the member's
  // case to the Booking Officers. Never on a locked-period row (which uses
  // `reason`).
  memberMessage        String?                    @db.VarChar(1000)
  // Attempt/conflict metadata. `attemptCount` counts submissions of this logical
  // proposal (a resubmission after a NO_HOLD capacity conflict bumps it); the
  // conflict fields record the most recent kept-pending capacity conflict so the
  // queue can explain why an otherwise-approvable request has not executed.
  attemptCount         Int                        @default(1)
  conflictCount        Int                        @default(0)
  lastConflictAt       DateTime?
  lastConflictReason   String?                    @db.VarChar(500)
  // Soft same-table pointer (never a FK: these rows are not deleted, the target
  // is always the same booking, and a self-relation would widen the member-merge
  // DMMF surface for no integrity gain). Set when a newer proposal SUPERSEDES
  // this one.
  supersededByRequestId String?
  cancelledAt          DateTime?
  // #2553: when this request's provisional capacity hold runs out. Set at
  // creation ONLY for a POLICY_EXCEPTION request that actually reserved beds —
  // a HOLD frozen aggregate WITH a non-empty incremental footprint (#2525) — and
  // never rewritten afterwards, so the reaper's deadline is a stable, immutable
  // fact rather than something a later write can move under a member. NULL means
  // "no TTL is STAMPED here", which is two populations: (a) nothing is at stake —
  // a LOCKED_PERIOD row, a NO_HOLD policy-exception request, or a HOLD request
  // whose footprint came out empty (a pure shrink); and (b) the row PREDATES this
  // column and IS holding beds, because the migration deliberately did not
  // backfill — written before it, or by a draining old colour. So NULL is NOT a
  // safe proxy for "holds no capacity": never filter a capacity question on
  // `holdExpiresAt IS NOT NULL`; the PolicyExceptionReservationNight rows are the
  // only reliable test. The reaper handles both — it releases the hold and moves
  // the request to EXPIRED once `now >= holdExpiresAt`, and for population (b) it
  // derives the same deadline from `createdAt` and the request's first held night;
  // see src/lib/cron-policy-exception-hold-reaper.ts.
  holdExpiresAt        DateTime?
  // Optimistic-concurrency token for the guarded approval claim, app-managed and
  // bumped on every mutating write — exactly the BookingRequest.version pattern
  // (#1923), and for the same reason: updatedAt is millisecond-precision and two
  // writes in one millisecond would silently defeat an updatedAt CAS.
  version              Int                        @default(1)
  // #2524: the DB-enforced one-open-request slot for a POLICY_EXCEPTION request.
  // Set to `pe:{bookingId}:{requestedByMemberId}` while a policy-exception
  // request is REQUESTED, and NULLed by every terminal transition (approve /
  // reject / cancel / supersede). PostgreSQL treats NULLs as distinct, so the
  // @unique index caps a member at ONE open policy-exception request per booking
  // race-safely, while leaving LOCKED_PERIOD rows (which never set it) and every
  // terminal row unconstrained. This is the durable backstop behind the
  // application open-request check; a lost create races into a unique violation,
  // never a second open row.
  openStateKey         String?                    @unique
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  booking            Booking              @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  requestedBy        Member               @relation("BookingChangeRequestsRequested", fields: [requestedByMemberId], references: [id], onDelete: Restrict)
  reviewedBy         Member?              @relation("BookingChangeRequestsReviewed", fields: [reviewedByMemberId], references: [id], onDelete: SetNull)
  linkedModification BookingModification? @relation("BookingChangeRequestLinkedModification", fields: [linkedModificationId], references: [id], onDelete: SetNull)
  // #2525: the provisional capacity reservation this request holds while pending.
  // Cascade, so a (never-in-practice) request delete cannot strand orphan rows;
  // in normal operation every row is deleted by the terminal transition or the
  // successful approval, in the SAME transaction that writes the outcome.
  reservationNights  PolicyExceptionReservationNight[] @relation("PolicyExceptionReservationRequest")

  @@index([bookingId, status, createdAt])
  @@index([requestedByMemberId, status, createdAt])
  @@index([status, createdAt])
  // The #2365 policy-exception queue: pending requests of one kind, oldest
  // first, so the officer view can show request age without a table scan.
  @@index([kind, status, createdAt])
  @@index([reviewedByMemberId, reviewedAt])
  @@index([linkedModificationId])
}

// #2525: a provisional per-night bed reservation held by a HELD policy-exception
// BookingChangeRequest.
//
// A row exists IFF the request is CURRENTLY holding that night's beds. There is
// deliberately NO "active" flag: a terminal transition (REJECTED / CANCELLED /
// SUPERSEDED) or a successful approval DELETES every row for the request in the
// SAME transaction that writes the outcome, so the canonical per-lodge capacity
// calculation (capacity.ts) counts "held reservations" simply by summing the
// rows that still exist. Today only the MODIFICATION path writes these rows: a
// held modification reserves the INCREMENTAL beds beyond a capacity-holding live
// booking (or the FULL proposed footprint when the base holds no capacity)
// (`computeProposalReservation`, booking-exception-requests.ts). New-booking
// reservation writes are DEFERRED to #2526. See docs/CONCURRENCY_AND_LOCKING.md →
// "Provisional reservations for held policy-exception requests (#2365)".
//
// The table carries NO Member FK by design: the owning BookingChangeRequest
// already links the member (`requestedByMemberId`), the rows are transient
// working capacity state, and member merge repoints the request rather than each
// reservation row — so nothing is added to the member-merge relation inventory.
model PolicyExceptionReservationNight {
  id              String   @id @default(cuid())
  changeRequestId String
  lodgeId         String
  // NZ lodge night (date-only), matching Booking.checkIn/checkOut day semantics.
  night           DateTime @db.Date
  // Beds this request holds on this night (always >= 1 in a written row).
  beds            Int
  createdAt       DateTime @default(now())

  changeRequest BookingChangeRequest @relation("PolicyExceptionReservationRequest", fields: [changeRequestId], references: [id], onDelete: Cascade)
  lodge         Lodge                @relation("PolicyExceptionReservationLodge", fields: [lodgeId], references: [id], onDelete: Restrict)

  // One row per (request, night): the reservation footprint is a set of nights.
  @@unique([changeRequestId, night])
  // The canonical capacity read: sum beds for one lodge across a night window.
  @@index([lodgeId, night])
}

// #2524: NEW-booking policy-exception requests. The #2365 BookingChangeRequest
// store cannot hold these — its `bookingId` is a required FK and a new booking
// has no row yet — so new-booking proposals get their own fully-constrained
// table (owner decision). A MODIFICATION request still lives on
// BookingChangeRequest (kind=POLICY_EXCEPTION); this is its new-booking twin,
// sharing the same status lifecycle (BookingChangeRequestStatus), the same
// frozen-evidence / proposal-hash / member-message discipline, the same
// app-managed `version` claim token and the same one-open-request `openStateKey`
// guard. The unified officer queue read (booking-exception-request-service.ts)
// merges both sources. This table is written ONLY by the request-creation and
// member cancel/supersede paths; the provisional-capacity reservation and the
// atomic approve-and-execute path are #2525 and touch no live booking here.
model NewBookingPolicyExceptionRequest {
  id                    String                     @id @default(cuid())
  // The lodge the proposed booking is for. RESTRICT mirrors every other
  // Lodge-owning table: a pending proposal must always resolve to a real lodge.
  lodgeId               String
  requestedByMemberId   String
  status                BookingChangeRequestStatus @default(REQUESTED)
  // The complete, IMMUTABLE NewBookingProposalSnapshot the member asks an admin
  // to allow — the full proposed party (dates + per-guest sparse nights). Frozen
  // at submit time; never rewritten. `proposalHash` is the canonical,
  // order-independent SHA-256 over it (src/lib/booking-exception-requests.ts),
  // so #2525's approval can prove what it executes is byte-for-byte what was
  // reviewed.
  proposalSnapshot      Json
  proposalHash          String                     @db.VarChar(64)
  // The frozen #2363 AggregatedPolicyExceptions (every covered structured
  // violation + the HOLD-if-any-HOLD aggregate) plus the denormalised aggregate
  // capacity mode the queue/capacity path filters on. Authoritative for what an
  // approval may override — and for nothing else.
  frozenEvidence        Json
  aggregateCapacityMode PolicyExceptionCapacityMode
  // Required, trimmed, <=1000-char member case to the Booking Officers.
  memberMessage         String                     @db.VarChar(1000)
  // Review outcome metadata (#2525 fills reviewedBy/reviewedAt/adminNotes on the
  // approve/reject decision).
  reviewedByMemberId    String?
  reviewedAt            DateTime?
  // MEMBER-VISIBLE, exactly as on BookingChangeRequest above (#2562): the
  // officer's decision explanation, written for the member and rendered to them.
  adminNotes            String?                    @db.VarChar(2000)
  // #2562: NEVER MEMBER-VISIBLE. See BookingChangeRequest.internalNotes — the
  // officer's private commentary, admin-guarded surfaces only.
  internalNotes         String?                    @db.VarChar(2000)
  // Attempt/conflict metadata, mirroring BookingChangeRequest: attemptCount
  // counts submissions of this logical proposal; the conflict fields record the
  // most recent kept-pending NO_HOLD capacity conflict (#2525) so the queue can
  // explain a not-yet-executed request.
  attemptCount          Int                        @default(1)
  conflictCount         Int                        @default(0)
  lastConflictAt        DateTime?
  lastConflictReason    String?                    @db.VarChar(500)
  // Soft same-table supersede pointer (never an FK: these rows are not deleted
  // and a self-relation would widen the member-merge DMMF surface for no gain).
  supersededByRequestId String?
  cancelledAt           DateTime?
  // Set by #2525's approve-and-execute seam to the Booking it created. A soft
  // pointer (not an FK) so #2525 owns the execution-linkage design; NULL until
  // executed.
  createdBookingId      String?
  // Optimistic-concurrency claim token, app-managed and bumped on every mutating
  // write — the BookingChangeRequest / BookingRequest.version pattern (#1923):
  // updatedAt is millisecond-precision and two writes in one millisecond would
  // silently defeat an updatedAt CAS.
  version               Int                        @default(1)
  // DB-enforced one-open-request slot: `nbpe:{requestedByMemberId}:{proposalHash}`
  // while REQUESTED, NULLed by every terminal transition (approve / reject /
  // cancel / supersede). PostgreSQL treats NULLs as distinct, so the @unique
  // index caps a member at ONE open request per identical proposal race-safely —
  // the durable backstop behind the application open-request check.
  openStateKey          String?                    @unique
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  lodge       Lodge   @relation(fields: [lodgeId], references: [id], onDelete: Restrict)
  requestedBy Member  @relation("NewBookingPolicyExceptionRequestsRequested", fields: [requestedByMemberId], references: [id], onDelete: Restrict)
  reviewedBy  Member? @relation("NewBookingPolicyExceptionRequestsReviewed", fields: [reviewedByMemberId], references: [id], onDelete: SetNull)

  // Officer queue: pending requests, oldest first, to show request age without a
  // table scan; plus the member's own list and a per-lodge slice.
  @@index([status, createdAt])
  @@index([requestedByMemberId, status, createdAt])
  @@index([lodgeId, status, createdAt])
}

// ---------------------------------------------------------------------------
// Email Delivery Tracking (N-10)
// ---------------------------------------------------------------------------

// NOTE: a value added here must also be registered in PostgreSQL with
// `ALTER TYPE "EmailLogStatus" ADD VALUE` in a migration.
enum EmailLogStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
  // #2258: deliberately withheld because the booking this message belongs to
  // carries the per-booking "No emails" switch. A terminal, non-retryable
  // outcome — distinct from BOUNCED (an undeliverable address, an operator
  // problem) and from FAILED (a transport error the retry cron replays).
  SKIPPED_NO_EMAILS
  // #3035 (ENV-SAFETY 2, epic #2986): held back because this installation is a
  // CONFIRMED COPY, not the club's live site. Terminal and non-retryable: a copy
  // stays a copy until somebody re-declares it, and replaying weeks of stale
  // confirmations at real members if they ever did would be worse than never
  // sending them.
  //
  // ITS OWN VALUE RATHER THAN A REUSE OF SKIPPED_NO_EMAILS, which was the
  // tempting shortcut. That value means the CLUB chose not to email this person
  // about this booking, and it renders on the booking page as exactly that
  // claim; a copy holding mail back is not a decision anybody made. It is also
  // what makes the withheld-email count on Admin -> Environment countable at
  // all (`environment-safety-withheld.ts`), which is the one signal that
  // separates a live club wrongly declared a copy from a copy nobody is using.
  SKIPPED_NON_PRODUCTION
}

/**
 * Why a send failed closed because this installation's environment role could
 * not be confirmed (#3035, INV-CONFIG-004).
 *
 * Only ever set beside `EmailLogStatus.FAILED`, which is deliberate: an
 * unconfirmed role is a FAULT and the message stays retryable, so it goes out by
 * itself once an operator declares the role. The column is what makes that row
 * distinguishable from an ordinary transport failure by something sturdier than a
 * message string, and the three values are kept apart because the repair differs —
 * set the variable, fix the value you already set, or restore database access.
 */
enum EmailDeliveryBlockReason {
  ENVIRONMENT_DECLARATION_MISSING
  ENVIRONMENT_DECLARATION_INVALID
  ENVIRONMENT_OVERRIDE_UNREADABLE
  // The deployment declares itself the club's live site AND declares a local
  // capture mailbox (USE_LOCAL_CAPTURE). Those cannot both be true: left to run,
  // it would accept every message, report every one as sent, and deliver none —
  // a silent total mail outage, which is the same harm as a wrongly-declared copy
  // arriving from the opposite direction.
  CAPTURE_TRANSPORT_IN_PRODUCTION
  // A COPY declares a local capture mailbox (USE_LOCAL_CAPTURE) while
  // EMAIL_SERVER_HOST names a host on the public internet, so the "capture" would
  // have delivered the message to a real member (#3071 review). Deliberately NOT
  // the value above: that one asserts this installation is the club's live site,
  // and environment-safety-withheld.ts counts it separately as precisely that
  // alarm, so writing it from a copy would report a live-site emergency that is
  // not happening.
  CAPTURE_TRANSPORT_PUBLIC_HOST
}

enum EmailSuppressionReason {
  BOUNCE
  COMPLAINT
}

model EmailLog {
  id            String         @id @default(cuid())
  to            String
  subject       String
  templateName  String
  htmlBody      String? // Stored only for retry-safe templates; token-bearing templates are redacted
  status        EmailLogStatus @default(QUEUED)
  errorMessage  String?
  attempts      Int            @default(1)
  lastAttemptAt DateTime       @default(now())
  sentAt        DateTime?
  messageId     String?
  // Booking this message belongs to (#2258), or null for account/security,
  // membership, family and admin mail that is not booking-scoped. Deliberately
  // a PLAIN indexed column with NO foreign key: EmailLog is a high-volume log
  // table (a validating FK would scan it, and would put a constraint on the hot
  // Booking table), and a withheld-email audit row must survive the hard
  // booking delete in booking-delete.ts rather than being nulled out.
  bookingId                      String?
  // Durable retry-time authority context (#2362). Null provenance flags mean
  // the row predates this context and must fail closed rather than infer an
  // identity from `to`. A null member id with non-null flags is an explicit
  // public/non-login or aggregate recipient and therefore receives no
  // authenticated booking-detail URL. The included-link bit fails closed if a
  // later deployment origin cannot safely locate the retained href.
  bookingRecipientMemberId       String?
  bookingBodyOverrideApplied     Boolean?
  bookingDetailLinkIncluded      Boolean?
  // Retryable HTML for new booking-scoped rows is quarantined here rather than
  // in legacy htmlBody. A rolled-back pre-#2362 worker filters on htmlBody and
  // therefore cannot replay a new row without the new authority checks.
  bookingRetryHtmlBody           String?        @db.Text
  // #3035: why an environment-safety block held this message back, or NULL for
  // every other row — an ordinary send, a business withhold, or a genuine
  // transport failure. Nullable and additive on purpose: the previously deployed
  // Prisma client selects explicit column lists, so it cannot see this column at
  // all and a blue/green drain is unaffected.
  deliveryBlockReason            EmailDeliveryBlockReason?
  createdAt                      DateTime       @default(now())
  updatedAt                      DateTime       @updatedAt

  @@index([to])
  @@index([status])
  @@index([createdAt])
  @@index([status, attempts])
  @@index([templateName, status, createdAt])
  @@index([bookingId, createdAt])
}

model EmailSuppression {
  id                        String                 @id @default(cuid())
  email                     String                 @unique
  reason                    EmailSuppressionReason
  eventCount                Int                    @default(1)
  suppressedAt              DateTime?
  lastEventAt               DateTime               @default(now())
  lastEventType             String
  lastBounceType            String?
  lastBounceSubType         String?
  lastComplaintFeedbackType String?
  lastSesMessageId          String?
  clearedAt                 DateTime?
  clearedById               String?
  clearReason               String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([suppressedAt])
  @@index([clearedAt])
  @@index([reason, suppressedAt])
  @@index([lastEventAt])
}

model IssueReport {
