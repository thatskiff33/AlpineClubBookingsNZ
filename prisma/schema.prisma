  updatedAt       DateTime             @updatedAt

  memberAssignments MemberAccessRole[]

  @@index([sortOrder])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  memberId  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// Single-use, short-lived passwordless sign-in token (#2034). Cloned from
// PasswordResetToken: only the SHA-256 hash of the emailed token is stored, the
// row is claimed atomically on first use, and it expires after the configurable
// magic-link TTL (default 15 minutes). Additive to password login — never a
// replacement or an email-verification bypass.
model MagicLinkToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  memberId  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  memberId  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([memberId])
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  memberId  String
  newEmail  String
