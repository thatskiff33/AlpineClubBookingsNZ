model FamilyGroupMember {
  id            String   @id @default(cuid())
  familyGroupId String
  memberId      String
  // NO `role` FIELD, AND NO `role` COLUMN. Membership in a group is the only
  // fact this table records: family-group membership carries no rank, and every
  // adult login co-member of a group is equal
  // (docs/DOMAIN_INVARIANTS.md -> family authorisation boundary).
  //
  // History, so the absence is not mistaken for an oversight. The column existed
  // as `"role" TEXT NOT NULL DEFAULT 'MEMBER'` from
  // 20260407120000_add_family_group_member_join_table. #2284 removed its last
  // authorisation reader (the one-step partner declaration in
  // member-partner-link.ts, re-anchored onto Member.detailsConfirmedByMemberId),
  // PR #2565 removed every remaining writer and payload reader plus
  // member-merge's vestigial maxFamilyRole upgrade and marked the field
  // `@ignore`, and #2520's CONTRACT migration
  // 20260803030000_contract_drop_family_group_member_role physically DROPPED the
  // column under a maintenance window (owner directive, 3 Aug 2026). Do not
  // reintroduce a rank column here without an owner decision on the
  // authorisation boundary above.
  joinedAt      DateTime @default(now())

  familyGroup FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  billedFamilyGroup FamilyGroup? @relation("FamilyBillingMembership")

  @@unique([familyGroupId, memberId])
  @@index([memberId])
  @@index([familyGroupId])
