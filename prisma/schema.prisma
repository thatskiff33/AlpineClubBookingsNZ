// ---------------------------------------------------------------------------
// Cron Job Run Tracking (OBS-09)
// ---------------------------------------------------------------------------

model CronJobRun {
  id            String    @id @default(cuid())
  jobName       String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  durationMs    Int?
  status        String // SUCCESS | FAILURE | SKIPPED
  resultSummary Json?
  error         String?
  createdAt     DateTime  @default(now())

  @@index([jobName])
  @@index([startedAt])
}

// Cross-process running-state + history for the managed database backup (#2095,
// C6). The nightly cron and the /admin/backups "run backup now" action both go
// through the SAME claim: a RUNNING row is created only under a brief
// `pg_advisory_xact_lock` so two containers (blue/green web slots + cron-leader,
// docker-compose.yml) can never start overlapping pg_dumps. Terminal states
// (SUCCESS | FAILURE | SKIPPED) close a run; a RUNNING row whose `heartbeatAt`
// has aged past the staleness window is reaped to FAILURE on the next claim so a
// container that died mid-dump never wedges the lock forever. The admin page
// polls this table for live status and last-run history; the durable backup
// record of truth remains S3 + the CronJobRun "backup" health signal.
model BackupRun {
  id                  String    @id @default(cuid())
  // RUNNING | SUCCESS | FAILURE | SKIPPED
  status              String
  // "scheduled" (nightly cron) | "manual" (admin run-now).
  trigger             String
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  // Set at claim and again at finalize — NOT refreshed at intermediate stages.
  // A RUNNING row whose heartbeatAt is older than the staleness window
  // (BACKUP_STALE_AFTER_MS) is treated as dead and reaped to FAILURE on the next
  // claim. Invariant: BACKUP_STALE_AFTER_MS must exceed the worst-case cumulative
  // command time (BACKUP_COMMAND_TIMEOUT_MS × the number of pg_dump/psql stages)
  // so a healthy but slow run is never reaped mid-dump.
  heartbeatAt         DateTime  @default(now())
  durationMs          Int?
  // Metadata-only summary (filename, sizeBytes, s3 flags…) — NEVER any secret
  // or DSN. Mirrors the CronJobRun.resultSummary shape.
  resultSummary       Json?
  error               String?
  // Full Admin/area-admin member id that pressed run-now (provenance); null for
  // scheduled runs.
  triggeredByMemberId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// Hut Leader Assignment (F8)
// ---------------------------------------------------------------------------

model HutLeaderAssignment {
  id           String   @id @default(cuid())
  memberId     String
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  hutLeaderPin String?
  // A hut leader serves one lodge (ADR-001 resolved question 5). Nullable
  // during the phase-4 expand release (null = the club's default lodge); a
  // later contract release enforces NOT NULL.
  lodgeId      String   @default(dbgenerated("default_lodge_id()"))
  // Custodian bed hold (#2286). Optional: an assignment WITHOUT a bed is the
  // pre-#2286 behaviour (a role only, zero capacity effect — including every
  // row the auto-assign cron creates). WITH a bed, the assignment is a
  // custodian occupancy: for the night of every covered date
  // (startDate <= night <= endDate, inclusive) that bed is out of the bookable
  // pool and out of the allocatable pool, with no Booking and no BedAllocation
  // row anywhere. Enforcement is application-code exclusion at the allocation
  // chokepoints under the per-lodge advisory lock (owner decision, option (a));
  // see src/lib/custodian-occupancy.ts and docs/CAPACITY_MODEL.md.
  //
  // onDelete: Restrict is the FK backstop behind the app-level guards: a bed
  // (or its room) can never be deleted out from under a live custodian hold.
  bedId        String?
  // Which writer created this row (#2926). Stamped ONCE, by the create, and
  // never recomputed — that is the entire point of the column. The overlap
  // predicate has to answer "was this row created as part of a school
  // booking?", and every property of the MEMBER that correlates with the
  // answer today is admin-writable: `Member.role` is derived from the access
  // roles (`legacyRoleFromAccessRoles` maps ORG -> SCHOOL), and the access
  // roles themselves are what the member editor's User Type control writes.
  // Deriving the exclusion from either means reclassifying a member as an
  // organisation silently removes their LIVE assignment from the overlap
  // check — a membership edit breaking a roster invariant it never touched.
  // Nothing writes this column after the insert, so no membership edit can
  // move it. See docs/CONCURRENCY_AND_LOCKING.md -> "Composition: lodge
  // admission, deactivation and hut-leader assignments".
  source       HutLeaderAssignmentSource @default(MANUAL)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  member Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  lodge  Lodge     @relation(fields: [lodgeId], references: [id], onDelete: Restrict)
  bed    LodgeBed? @relation(fields: [bedId], references: [id], onDelete: Restrict)

  @@index([memberId])
  @@index([startDate, endDate])
  @@index([lodgeId])
  @@index([bedId])
}

// Provenance of a HutLeaderAssignment row (#2926). Set by whichever writer
// created it; there is no other writer and no derivation.
//
// MANUAL          POST /api/admin/hut-leaders — an officer assigned this leader.
// CRON            cron-hut-leader-auto-assign — the nightly sole-adult rule.
// SCHOOL_BOOKING  school-booking-request.ts — one row per TEACHER when a school
//                 request is approved. These rows deliberately overlap each
//                 other (several teachers supervise one group) and are the rows
//                 the overlap predicate excludes.
enum HutLeaderAssignmentSource {
  MANUAL
  CRON
  SCHOOL_BOOKING
}

// Per-lodge access grants (docs/multi-lodge/lodge-scoping-contract.md,
// ADR-001 resolved questions 2 and 5).
//
// BOOKING_RESTRICTION: a member with any rows of this kind may book ONLY the
// listed lodges. No rows = default-open (every active member books every
// active lodge) — the club-wide default that most members keep forever.
//
// STAFF: binds a lodge-operational account (shared kiosk login) to a lodge so
// its kiosk screens and PIN logins scope to that property. ADMIN access is
// club-wide and never expressed through this table.
enum LodgeAccessKind {
  BOOKING_RESTRICTION
  STAFF
}

model MemberLodgeAccess {
