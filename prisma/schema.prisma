model MemberApplication {
  id                    String            @id @default(cuid())
  applicantFirstName    String
  applicantLastName     String
  applicantEmail        String
  applicantDateOfBirth  DateTime? @db.Date
  applicantPhone        String?
  applicantAddress      Json?
  familyMembers         Json?
  nominator1Email       String
  nominator2Email       String
  nominator1Id          String?
  nominator2Id          String?
  nominator1ConfirmedAt DateTime?
  nominator2ConfirmedAt DateTime?
  status                ApplicationStatus @default(PENDING_NOMINATORS)
  adminNotes            String?
  reviewedBy            String?
  reviewedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  nominationTokens NominationToken[]
  induction        MemberInduction?

  // Pending-application uniqueness is enforced by the manual partial unique index
  // MemberApplication_pending_applicantEmail_unique in Prisma migrations.
  @@index([applicantEmail])
  @@index([status, createdAt])
  @@index([nominator1Id])
  @@index([nominator2Id])
}

model NominationToken {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  applicationId     String
  nominatorMemberId String
  expiresAt         DateTime
  confirmedAt       DateTime?
  reminderCount     Int       @default(0)
  lastSentAt        DateTime?
  createdAt         DateTime  @default(now())

  application MemberApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([nominatorMemberId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([confirmedAt, expiresAt])
}

// Single-use, hash-at-rest bearer token that invites a partner who has no
// account yet to join a family group by email (#1682). Modelled on
// NominationToken: only the sha256 hash of the raw token is stored, the raw
// token travels once in the invite email, and the row is single-use via
// confirmedAt. The invitee registers through the normal membership process and
// then claims this token to be auto-filed/accepted as an ADULT_INVITE into the
// (approved) family group.
model PartnerInviteToken {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  familyGroupId String
  invitedEmail  String
  createdById   String
  expiresAt     DateTime
  confirmedAt   DateTime?
  reminderCount Int       @default(0)
  lastSentAt    DateTime?
  createdAt     DateTime  @default(now())
  // Opt-in (#1742): when true, claiming this token also forms a CONFIRMED
  // MemberPartnerLink between createdBy and the claimer — the claim is the
  // partner's consent. Never set retroactively; the inviter opts in at mint.
  createPartnerLink Boolean @default(false)

  familyGroup FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  createdBy   Member      @relation("PartnerInviteTokenCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([familyGroupId])
  @@index([createdById])
  @@index([expiresAt])
  @@index([invitedEmail])
}

// ---------------------------------------------------------------------------
// Membership Subscriptions
// ---------------------------------------------------------------------------

model MemberSubscription {
  id                   String             @id @default(cuid())
  memberId             String
  seasonYear           Int
  status               SubscriptionStatus @default(NOT_INVOICED)
  xeroInvoiceId        String?
  xeroInvoiceNumber    String?
  xeroOnlineInvoiceUrl String?
  paidAt               DateTime?
  // E14 (#1944): manual mark-paid provenance for clubs that do not use Xero (or
  // one-off cash payments). Set together by the finance:edit manual-payment
  // endpoint when a subscription is marked PAID outside the Xero pipeline, and
  // cleared together on reversal. Xero sync/webhook paths never touch a row
  // whose manuallyMarkedPaidAt is set while it carries no Xero invoice link, so
  // a manual PAID is never silently downgraded.
  manuallyMarkedPaidAt         DateTime?
  manuallyMarkedPaidByMemberId String?
  manualPaymentNote            String?   @db.VarChar(500)
  // #2147: monotonic re-bill discriminator. Incremented each time the
  // membership sync observes this season's Xero invoice VOIDED/DELETED and
  // releases the coverage claim. The confirm step folds it into the charge
  // idempotencyKey so a post-void re-bill mints a NEW charge instead of
  // no-op-ing onto the released one. Stays 0 for a never-voided subscription,
  // which keeps the idempotencyKey byte-identical to the pre-#2147 shape.
  voidGeneration       Int       @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Relations
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  manuallyMarkedPaidBy Member? @relation("MemberSubscriptionManualPaidBy", fields: [manuallyMarkedPaidByMemberId], references: [id], onDelete: SetNull)
  // #2147: was a to-one relation while coverage.subscriptionId was @unique.
  // Now that a released claim is retained alongside a fresh active claim, a
  // subscription can accrue several coverage rows over its lifetime (at most
  // one ACTIVE — releasedAt IS NULL — at a time, enforced by the raw-SQL
  // partial unique index in prisma/partial-unique-indexes.tsv).
  chargeCoverage MembershipSubscriptionChargeCoverage[]

  @@unique([memberId, seasonYear])
  @@index([memberId])
  @@index([seasonYear])
  @@index([seasonYear, status])
  @@index([manuallyMarkedPaidByMemberId])
  // #2400: "who else does this Xero invoice cover?" is asked with
  // `where: { xeroInvoiceId: { in: [...] } }` on every admin cancellation-queue
  // page load and again at every approval, and the column had no index at all,
  // so each of those was a sequential scan of the whole table.
  @@index([xeroInvoiceId])
}

// Immutable financial snapshot for one membership subscription invoice decision.
// Only operational delivery fields (status/Xero/email metadata) may change after
// creation; fee, coverage, recipient and proration columns never do.
model MembershipSubscriptionCharge {
  id                    String                             @id @default(cuid())
  idempotencyKey        String                             @unique
  seasonYear            Int
  source                MembershipSubscriptionChargeSource
  status                MembershipSubscriptionChargeStatus @default(QUEUED)
  membershipAnnualFeeId String?
  membershipTypeId      String
  membershipTypeKey     String
  membershipTypeName    String
  billingBasis          MembershipFeeBillingBasis
  prorationRule         MembershipFeeProrationRule
  annualAmountCents     Int
  chargedAmountCents    Int
  coveredMonths         Int
  decisionDate          DateTime                           @db.Date
  coverageStart         DateTime                           @db.Date
  coverageEnd           DateTime                           @db.Date
  familyGroupId         String?
  recipientMemberId     String
  recipientName         String
  recipientEmail        String
  dueDays               Int
  xeroAccountCode       String?
  xeroItemCode          String?
  invoiceReference      String                             @unique
  xeroInvoiceId         String?                            @unique
  xeroInvoiceNumber     String?
  xeroInvoiceUrl        String?
  xeroInvoiceAdopted    Boolean                            @default(false)
  invoicePersistedAt    DateTime?
  emailAttemptCount     Int                                @default(0)
  emailLastAttemptAt    DateTime?
  emailSentAt           DateTime?
  lastErrorCode         String?
  lastErrorMessage      String?
  confirmedByMemberId   String?
  confirmedAt           DateTime?
  createdAt             DateTime                           @default(now())
  updatedAt             DateTime                           @updatedAt

  recipient   Member   @relation("MembershipChargeRecipient", fields: [recipientMemberId], references: [id], onDelete: Restrict)
  confirmedBy Member?  @relation("MembershipChargeConfirmer", fields: [confirmedByMemberId], references: [id], onDelete: SetNull)
  coverage    MembershipSubscriptionChargeCoverage[]
  components  MembershipSubscriptionChargeComponent[]

  @@index([seasonYear, status, createdAt])
  @@index([recipientMemberId, seasonYear])
  @@index([familyGroupId, seasonYear])
  @@unique([seasonYear, membershipTypeId, familyGroupId], map: "MembershipCharge_family_type_year_key")
}

// Frozen per-line snapshot of an annual-fee component at the moment the charge
// was confirmed (#1932, E6). One row per Xero invoice line. The immutable-charge
// invariant EXTENDS to these rows: once written they are never mutated, and the
// invoice builder emits one line per component in sortOrder. A legacy charge
// backfilled with a single component reproduces the identical historical
// single-line invoice on re-drive (adoption / EMAIL_FAILED retry). xeroAccountCode
// is required because a NO_INVOICE charge has zero components and every invoiceable
// charge resolves an account (override else the frozen subscriptionIncome mapping).
model MembershipSubscriptionChargeComponent {
  id                 String   @id @default(cuid())
  chargeId           String
  label              String
  description        String
  annualAmountCents  Int
  chargedAmountCents Int
  prorated           Boolean
  xeroAccountCode    String
  xeroItemCode       String?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())

  charge MembershipSubscriptionCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@index([chargeId, sortOrder])
}

model MembershipSubscriptionChargeCoverage {
  id             String   @id @default(cuid())
  chargeId       String
  subscriptionId String
  memberId       String
  memberName     String
  // #2147: null while the claim is ACTIVE. Set (never cleared, row never
  // deleted) when the membership sync observes the charge's Xero invoice
  // VOIDED/DELETED, releasing the claim so a fresh preview can re-bill the
  // member. The dedup skip-set and the confirm coveredAlready check count only
  // active (releasedAt IS NULL) claims. "One active claim per subscription" is
  // enforced by the raw-SQL partial unique index
  // MembershipSubscriptionChargeCoverage_active_subscription_unique
  // (prisma/partial-unique-indexes.tsv) — Prisma cannot express it, which is
  // why the plain subscriptionId @unique was dropped.
  releasedAt     DateTime?
  createdAt      DateTime @default(now())

  charge       MembershipSubscriptionCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  subscription MemberSubscription            @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([chargeId, subscriptionId], map: "MembershipChargeCoverage_charge_subscription_key")
  @@index([chargeId])
  @@index([subscriptionId])
  @@index([memberId, createdAt])
}

// #2161 (D2): an explicit operator "already invoiced" marker for one family
// group in one membership season. An operator sets this when they KNOW an
// ambiguous legacy invoice — e.g. one sitting on a member whose current resolved
// billing basis is PER_MEMBER — actually covered the whole family. It closes the
// double-billing window the #2161 D1 predicate refinement re-opens for
// mixed-basis families (where a PER_MEMBER member's personal live invoice no
// longer blocks the family fee). An ACTIVE marker (releasedAt IS NULL) suppresses
// the family's PER_FAMILY charge in the billing preview — and therefore in the
// in-transaction confirm re-preview — regardless of the D1 predicate. Unmark sets
// releasedAt (the row is retained for audit, mirroring the coverage-release
// pattern in MembershipSubscriptionChargeCoverage); a fresh mark then inserts a
// new row. "At most one ACTIVE marker per (familyGroupId, seasonYear)" is enforced
// by the raw-SQL partial unique index FamilyGroupSeasonInvoiceMarker_active_unique
// (prisma/partial-unique-indexes.tsv) — Prisma cannot express a partial unique
// index. The audit FKs are nullable + SetNull (mirroring
// MembershipSubscriptionCharge.confirmedByMemberId) so removing the operator
// account never deletes the marker.
model FamilyGroupSeasonInvoiceMarker {
  id                 String    @id @default(cuid())
  familyGroupId      String
  seasonYear         Int
  markedByMemberId   String?
  markedAt           DateTime  @default(now())
  // Optional free text, e.g. the covering invoice number the operator knows about.
  note               String?
  releasedAt         DateTime?
  releasedByMemberId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  familyGroup FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  markedBy    Member?     @relation("FamilyInvoiceMarkerMarkedBy", fields: [markedByMemberId], references: [id], onDelete: SetNull)
  releasedBy  Member?     @relation("FamilyInvoiceMarkerReleasedBy", fields: [releasedByMemberId], references: [id], onDelete: SetNull)

  @@index([familyGroupId, seasonYear])
  @@index([seasonYear])
  @@index([markedByMemberId])
  @@index([releasedByMemberId])
}

model MembershipBillingException {
  id             String                           @id @default(cuid())
  fingerprint    String                           @unique
  seasonYear     Int
  source         MembershipSubscriptionChargeSource
  status         MembershipBillingExceptionStatus @default(OPEN)
  code           String
  message        String
  memberId       String?
  familyGroupId  String?
  membershipTypeId String?
  context        Json?
  firstSeenAt    DateTime                         @default(now())
  lastSeenAt     DateTime                         @default(now())
  resolvedAt     DateTime?
  // #2148 (D2): resolution provenance — CONFIRM vs PREVIEW_RECONCILE. Null while
  // OPEN and on rows resolved before this column existed.
  resolvedVia    MembershipBillingExceptionResolution?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt

  member Member? @relation("MembershipBillingExceptionMember", fields: [memberId], references: [id], onDelete: SetNull)

  @@index([status, seasonYear, lastSeenAt])
  @@index([memberId, status])
  @@index([familyGroupId, status])
}

model MembershipSubscriptionBillingSettings {
  id                String            @id @default("default")
  invoiceDueDays    Int               @default(30)
  // Club billing model. BILL_FAMILY_VIA_BILLING_MEMBER (the default, preserving
  // pre-#159 behaviour) invoices each family once via its nominated billing
  // member and allows PER_FAMILY fee schedules. BILL_MEMBERS_INDIVIDUALLY
  // invoices every member directly, hides the family-billing surface, and
  // disallows PER_FAMILY schedules.
  familyBillingMode FamilyBillingMode @default(BILL_FAMILY_VIA_BILLING_MEMBER)
  updatedByMemberId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ---------------------------------------------------------------------------
// Seasonal Membership Types
// ---------------------------------------------------------------------------

model MembershipType {
  id                   String                             @id @default(cuid())
  // Stable identifier used by seeds, migrations, and follow-up enforcement
  // work. Display names can change without changing this key.
  key                  String                             @unique
  name                 String
  description          String?                            @db.Text
  publicDescription    String?                            @db.Text
  publiclyListed       Boolean                            @default(false)
  isActive             Boolean                            @default(true)
  isBuiltIn            Boolean                            @default(false)
  bookingBehavior      MembershipTypeBookingBehavior      @default(MEMBER_RATE)
  subscriptionBehavior MembershipTypeSubscriptionBehavior @default(REQUIRED)
  // When true, this type's hut nightly rates are keyed per age tier; when
  // false, the type prices from a single flat rate (one NULL-ageTier
  // MembershipTypeSeasonRate row per season). Day-one backfill copies the
  // per-tier legacy rates, so every type starts age-keyed (#1930, E4).
  ageGroupsApply       Boolean                            @default(true)
  sortOrder            Int                                @default(0)
  createdAt            DateTime                           @default(now())
  updatedAt            DateTime                           @updatedAt

  assignments           SeasonalMembershipAssignment[]
  allowedAgeTiers       MembershipTypeAgeTier[]
  xeroContactGroupRules XeroContactGroupRule[]
  annualFees            MembershipAnnualFee[]
  seasonRates           MembershipTypeSeasonRate[]
  joiningFees           JoiningFee[]
  noticeAudiences       NoticeAudience[]

  @@index([isActive, sortOrder])
  @@index([sortOrder])
}

// Annual membership fee schedule keyed by membership type x optional age tier
// (#2067). Mirrors JoiningFee's Flat-vs-per-tier shape: an age-keyed type may
// carry one row per tier, while the flat NULL-ageTier row is the whole-type
// fallback (a member of any tier resolves it when no per-tier row matches, and
// NOT_APPLICABLE members resolve it directly). A companion raw-SQL partial
// unique index (WHERE "ageTier" IS NULL) enforces one flat window per (type,
// effectiveFrom) and lives in the migration + prisma/partial-unique-indexes.tsv.
// PER_FAMILY fees stay flat-only (a raw-SQL CHECK forbids ageTier IS NOT NULL
// for PER_FAMILY), and two partial GiST EXCLUDE constraints (one over flat rows,
// one over per-tier rows — an enum->text cast is only STABLE, so a single
// COALESCE-based EXCLUDE is illegal) keep windows non-overlapping per (type,
// tier) while letting flat-vs-tier and cross-tier windows coexist — all raw SQL,
// not modelled here.
model MembershipAnnualFee {
  id               String                       @id @default(cuid())
  membershipTypeId String
  ageTier          AgeTier?
  amountCents      Int
  billingBasis     MembershipFeeBillingBasis
  prorationRule    MembershipFeeProrationRule   @default(NONE)
  effectiveFrom    DateTime                     @db.Date
  effectiveTo      DateTime?                    @db.Date
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  membershipType MembershipType                 @relation(fields: [membershipTypeId], references: [id], onDelete: Restrict)
  components     MembershipAnnualFeeComponent[]

  @@unique([membershipTypeId, ageTier, effectiveFrom])
  @@index([membershipTypeId, ageTier, effectiveFrom, effectiveTo], map: "MembershipAnnualFee_effective_lookup_idx")
}

// Named components of an annual membership fee (#1932, E6, item 9). Each becomes
// its own Xero invoice line — e.g. base membership + work party fee + FMC
// subscription — optionally coded to its own GL account/item, each with its own
// choice of whether it is prorated for mid-year joiners. INVARIANT: Σ(amountCents)
// == the parent fee's amountCents, validated server-side in one transaction, so
// the fee total stays authoritative and existing preview/consumers are unchanged.
// Every non-NO_INVOICE MembershipAnnualFee carries ≥1 component at all times; a
// NO_INVOICE fee is a zero total with no components. The default component (label
// "Annual membership fee", prorate true) is auto-created on fee creation and
// copied forward when a new effective-dated fee row supersedes a predecessor.
model MembershipAnnualFeeComponent {
  id                    String   @id @default(cuid())
  membershipAnnualFeeId String
  label                 String
  amountCents           Int
  prorate               Boolean  @default(true)
  xeroAccountCode       String?
  xeroItemCode          String?
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  membershipAnnualFee MembershipAnnualFee @relation(fields: [membershipAnnualFeeId], references: [id], onDelete: Cascade)

  @@index([membershipAnnualFeeId, sortOrder])
}

// EntranceFee (the category-keyed one-off fee table) was dropped by the E13
// contract migration 20260720120000 (#1939): the joining-fee re-key (JoiningFee,
// keyed by membership type x optional age tier) superseded it in E5 (#1931) and
// no runtime code reads it. The `EntranceFeeCategory` enum is deliberately
// RETAINED — it still keys XeroItemCodeMapping.entranceFeeCategory for the live
// JOINING_FEE item-code mappings (the E5 re-key carried those rows forward under
// category "JOINING_FEE" but kept the physical column + enum names).

// Joining-fee schedule keyed by membership type x optional age tier (#1931,
// E5). Renames + re-keys the legacy category-keyed EntranceFee: an age-keyed
// type carries one row per age tier (INFANT folds onto the CHILD amount), while
// a flat-fee type (the built-in Family type) carries a single NULL-ageTier row.
// The migration fans the old category amounts out to every joining-fee-liable
// membership type so day-one resolution stays byte-identical. A companion
// raw-SQL partial unique index (WHERE "ageTier" IS NULL) enforces one flat row
// per (type, effectiveFrom) and lives in the migration +
// prisma/partial-unique-indexes.tsv.
model JoiningFee {
  id               String    @id @default(cuid())
  membershipTypeId String
  ageTier          AgeTier?
  amountCents      Int
  effectiveFrom    DateTime  @db.Date
  effectiveTo      DateTime? @db.Date
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  membershipType MembershipType @relation(fields: [membershipTypeId], references: [id], onDelete: Restrict)

  @@unique([membershipTypeId, ageTier, effectiveFrom])
  @@index([membershipTypeId, ageTier, effectiveFrom, effectiveTo], map: "JoiningFee_effective_lookup_idx")
}

model MembershipTypeAgeTier {
  id               String   @id @default(cuid())
  membershipTypeId String
  ageTier          AgeTier
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  membershipType MembershipType @relation(fields: [membershipTypeId], references: [id], onDelete: Cascade)

  @@unique([membershipTypeId, ageTier])
  @@index([ageTier])
}

model XeroContactGroupRule {
  id               String                   @id @default(cuid())
  membershipTypeId String?
  // Set of age tiers this rule targets (#2093). Stored canonical-sorted; the
  // empty array `[]` means "all age tiers" (the old null "Any age" semantics).
  // Normalization collapses a full-tier-set selection to `[]` so "all tiers"
  // has exactly one canonical shape.
  ageTiers         AgeTier[]
  mode             XeroContactGroupRuleMode
  groupId          String
  groupName        String?
  isActive         Boolean                  @default(true)
  sortOrder        Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  membershipType MembershipType? @relation(fields: [membershipTypeId], references: [id], onDelete: Cascade)

  @@index([membershipTypeId])
  @@index([mode, isActive, sortOrder])
  @@index([groupId])
  // Dedupe of identical rule shapes is enforced by a raw-SQL partial unique
  // index (E8 #1934, multi-select #2093) — Prisma cannot express NULLS NOT
  // DISTINCT, so the index lives in the migration and is recorded in
  // prisma/partial-unique-indexes.tsv:
  //   XeroContactGroupRule_shape_unique on
  //   (membershipTypeId, ageTiers, mode, groupId) NULLS NOT DISTINCT.
  // Canonical-sorted array storage makes [ADULT, YOUTH] == [YOUTH, ADULT] a
  // single stored shape, so btree array equality dedupes correctly.
  // App-side rule CRUD enforces the same dedupe for friendly errors.
}

// Single-row ("default") club setting selecting the Xero member-grouping mode
// (E8, #1934). Governs syncManagedXeroContactGroupForMember and the
// cancellation-path managed universe. Backfilled to MEMBERSHIP_TYPE_AND_AGE for
// installs that had any age-tier Xero group config (Tokoroa), otherwise NONE.
model XeroGroupingSettings {
  id                String                 @id @default("default")
  mode              XeroMemberGroupingMode @default(NONE)
  updatedByMemberId String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([updatedByMemberId])
}

// Server-side provenance of a member-grouping dry-run (#1961, follow-up to E8
// #1934). Persisted whenever an admin runs the dry-run so the bulk re-sync can
// enforce, server-side and independent of any client-asserted flag, that a
// recent reviewed diff exists AND still matches the CONTACT_GROUP_FULL_REFRESH
// group-cache cursor + active grouping rules it was computed against. The bulk
// re-sync rejects a run whose referenced dry-run is absent, expired, or was
// computed against a now-changed cache cursor / rule set.
model XeroMemberGroupingDryRun {
  id                String                 @id @default(cuid())
  mode              XeroMemberGroupingMode
  // The CONTACT_GROUP_FULL_REFRESH cursor lastSuccessfulSyncAt this dry-run was
  // computed against; the bulk re-sync rejects when the live cursor differs.
  cacheCursorAt     DateTime
  // Stable digest of (mode + active rules) at dry-run time; a rule/mode change
  // moves the live fingerprint and the bulk re-sync rejects.
  rulesFingerprint  String
  // Stable digest of the planned add/remove operations the admin reviewed.
  plannedDigest     String
  mismatchCount     Int
  addCount          Int
  removeCount       Int
  // Server-set claim marker (#1961): stamped once, atomically, when the bulk
  // re-sync is INITIATED from this dry-run. Null = never started. A resume is
  // valid only against a started run; the status-guarded claim rejects
  // double-initiates.
  startedAt         DateTime?
  createdByMemberId String?
  createdAt         DateTime               @default(now())

  @@index([createdAt])
  @@index([createdByMemberId])
}

model SeasonalMembershipAssignment {
  id                 String                     @id @default(cuid())
  memberId           String
  seasonYear         Int
  membershipTypeId   String
  applyFrom          DateTime?                  @db.Date
  assignedByMemberId String?
  source             MembershipAssignmentSource @default(ADMIN)
  sourceDetail       String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  member         Member         @relation("SeasonalMembershipAssignmentMember", fields: [memberId], references: [id], onDelete: Cascade)
  membershipType MembershipType @relation(fields: [membershipTypeId], references: [id], onDelete: Restrict)
  assignedBy     Member?        @relation("SeasonalMembershipAssignmentAssignedBy", fields: [assignedByMemberId], references: [id], onDelete: SetNull)

  @@unique([memberId, seasonYear])
  @@index([seasonYear])
  @@index([membershipTypeId])
  @@index([seasonYear, membershipTypeId])
  @@index([assignedByMemberId])
}

