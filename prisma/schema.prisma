  memberships   FamilyGroupMember[]
  // Members who have selected this group as their per-member billing family (#1932, E6).
  billingSelectedMembers Member[]        @relation("MemberBillingFamily")
  joinRequests  FamilyGroupJoinRequest[]
  partnerInviteTokens PartnerInviteToken[]
  // #2161 (D2): operator "already invoiced" markers for this group, per season.
