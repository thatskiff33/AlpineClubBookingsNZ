  nonMemberHoldEnabled Boolean  @default(true)
  nonMemberHoldDays    Int      @default(7)
  cancellationRules    Json // Array of {daysBeforeStay: number, refundPercentage: number}
  active               Boolean  @default(true)
  // Null = applies club-wide; a lodgeId scopes the period to that lodge
  // (ADR-001 resolved question 3). Permanently nullable.
  lodgeId              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  lodge Lodge? @relation(fields: [lodgeId], references: [id], onDelete: Restrict)

  @@index([startDate, endDate])
  @@index([lodgeId])
}

// ---------------------------------------------------------------------------
// Booking Defaults (global settings, single row)
// ---------------------------------------------------------------------------

// Cross-lodge waitlist queue order (ADR-004, owner decision 1): per
// candidate, OWN_LODGE_FIRST considers their own-lodge chance before any
// cross-lodge opt-in; across candidates the pass runs in club-wide join
// order (owner-accepted, #1566 — see ADR-004 implementation notes), so a
// freed lodge's queue is not necessarily exhausted first. MERGED ranks
// everyone eligible purely by when they joined. Club-wide policy.
enum WaitlistCrossLodgeOrder {
  OWN_LODGE_FIRST
  MERGED
}

model BookingDefaults {
  id                      String                  @id @default("default")
  nonMemberHoldEnabled    Boolean                 @default(true)
  nonMemberHoldDays       Int                     @default(7)
  waitlistCrossLodgeOrder WaitlistCrossLodgeOrder @default(OWN_LODGE_FIRST)
  // Soft link for the phase-7 singleton-to-per-lodge conversion
  // (docs/multi-lodge/implementation-plan.md); unused by runtime reads today.
  lodgeId                 String?
}

// Alternate lodges a waitlisted member would also accept (ADR-004). The
// entry itself stays bound to Booking.lodgeId — these rows only widen what
// the waitlist processor may offer. Rows are deleted with their booking.
model BookingWaitlistAlternateLodge {
  id        String   @id @default(cuid())
  bookingId String
  lodgeId   String
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lodge   Lodge   @relation("WaitlistAlternateLodge", fields: [lodgeId], references: [id], onDelete: Cascade)

  @@unique([bookingId, lodgeId])
  @@index([lodgeId])
}

// ---------------------------------------------------------------------------
// Minimum Stay Policies
// ---------------------------------------------------------------------------

enum PolicyExceptionCapacityMode {
  HOLD
  NO_HOLD
}

model MinimumStayPolicy {
  id            String                      @id @default(cuid())
  name          String // e.g. "Winter Saturday Minimum Stay"
  startDate     DateTime                    @db.Date
  endDate       DateTime                    @db.Date
  triggerDays   Int[] // Days of week: 0=Sunday, 1=Monday, ..., 6=Saturday
  minimumNights Int
  active        Boolean                     @default(true)
  // Frozen onto every violation/review snapshot. The DB default exists only
  // for blue/green compatibility with the draining pre-#2363 runtime; every
  // #2363 API/UI create requires an explicit value.
  capacityMode  PolicyExceptionCapacityMode @default(HOLD)
  // Stable policy revision. Writers increment this integer for every material
  // mutation and use it as their compare-and-swap token; timestamps are not a
  // version because millisecond collisions are possible.
  version       Int                         @default(1)
  // Null = applies club-wide; a lodgeId scopes the policy to that lodge
  // (ADR-001 resolved question 3). Permanently nullable.
  lodgeId       String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  lodge Lodge? @relation(fields: [lodgeId], references: [id], onDelete: Restrict)

  @@index([startDate, endDate])
  @@index([active])
  @@index([lodgeId])
}

// ---------------------------------------------------------------------------
// Adult-member hosting policy (#2364, epic decision D-R3/D-R4)
// ---------------------------------------------------------------------------

// The CONSEQUENCE when a non-member guest-night has no qualifying adult-member
// host (#2364; three-way since the owner's #2569 decision).
//
// Deliberately named for the consequence rather than for the rule, because the
// rule itself is now a SECOND, independent dimension — which adult members count
// (the hostScope* columns below). A club sets both.
//
// INHERIT is a LODGE-ONLY value: it is how a lodge says "use the club default"
// while still owning a row (so config transfer and the admin screen can state
// the choice explicitly rather than inferring it from an absent row). The
// migration's CHECK constraint refuses INHERIT on the club-wide row, which is
// what makes resolution terminate.
//
// ENFORCED (#2569) refuses the write with HTTP 409 `ADULT_MEMBER_HOSTING_REQUIRED`
// and opens the existing #2365 policy-exception door; it is never selected by a
// migration, so no existing club moves onto it by upgrading.
enum AdultMemberHostingMode {
  INHERIT
  DISABLED
  ADMIN_REVIEW_REQUIRED
  ENFORCED
}

model AdultMemberHostingPolicy {
  id String @id @default(cuid())

  // Null = the club-wide default row; a lodgeId is that lodge's override.
  // Permanently nullable, like the other policy tables (ADR-001).
  lodgeId String?

  // Denormalised scope identity: `COALESCE(lodgeId, 'club-wide')`, enforced by
  // a CHECK constraint so it can never drift from lodgeId. It exists because
  // PostgreSQL treats NULLs as distinct in a unique index, so a plain
  // `@unique` on lodgeId would happily admit a SECOND club-wide row and make
  // resolution non-deterministic. A partial unique index would also work, but
  // this column additionally IS the config-transfer natural key and the audit
  // key, so one column earns all three. Lodge ids are cuids, so a real lodge id
  // can never collide with the 'club-wide' literal.
  scopeKey String @unique

  mode AdultMemberHostingMode

  // Frozen onto every violation/review snapshot. Deliberately carries NO
  // database default (D-R6: capacity mode is explicit for new policies) — the
  // table is created empty by the same migration, so there is no row to back-
  // fill and no draining old colour that could insert without naming it.
  capacityMode PolicyExceptionCapacityMode

  // WHICH adult members count as supplying coverage (#2569, the owner's second
  // policy dimension). Independent of `mode`, resolved independently, and
  // combined with OR: a non-member guest-night is compliant where AT LEAST ONE
  // enabled scope supplies eligible adult-member coverage for that exact night.
  //
  // TWO COLUMNS, AND THESE TWO. The spec named three scopes; the owner's
  // decisions of 3 Aug 2026 settled the model at two. The lodge-wide "any adult
  // member staying at the lodge" scope is REMOVED (#2575) — a booking must not
  // become compliant because an unrelated member happens to be at the lodge — and
  // the nominated-host scope is REPLACED (#2576) by SAME_BOOKING_OWNER: coverage
  // from a qualifying adult member attending another eligible booking with the
  // exact same `Booking.memberId`. Neither removal is a deferral, so there is no
  // reserved column for either: nothing here can be switched on without
  // re-deciding the policy.
  //
  // BOTH ARE NULLABLE TOGETHER, and the migration's CHECK holds them to all-null
  // or all-set. NULL means "this scope did not decide", which is what makes the
  // second dimension inherit the same way the first one does:
  //
  //   - a lodge row with both NULL inherits the club's scope set (the
  //     "Inherit club host scopes" option), whatever its own `mode` says;
  //   - a lodge row with them set is that lodge's custom scope set;
  //   - the club row with both NULL means the club never decided, which
  //     resolves to the BUILT-IN DEFAULT — same-booking only.
  //
  // That built-in default is what makes the upgrade a no-op (#2569 §15): every
  // existing row keeps NULL, so every existing club keeps judging exactly the
  // same-booking coverage it judged before, and no club is silently widened to
  // same-owner coverage. A club opts in by saving it.
  //
  // Nullable rather than `Boolean @default(...)` deliberately. A default would
  // make "the club has not decided" indistinguishable from "the club chose
  // same-booking only", which is the same distinction `configured` draws on the
  // admin card, and would also mean a draining old colour's INSERT silently
  // asserted a decision it never made.
  hostScopeSameBooking      Boolean?
  hostScopeSameBookingOwner Boolean?

  // Stable policy revision and compare-and-swap token, managed by the
  // AdultMemberHostingPolicy_version trigger. Same contract as
  // MinimumStayPolicy.version (#2363): timestamps are not a version.
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lodge Lodge? @relation(fields: [lodgeId], references: [id], onDelete: Restrict)

  @@index([lodgeId])
}

// ---------------------------------------------------------------------------
// Same-owner hosting coverage: incidents and bounded re-evaluation work (#2576)
// ---------------------------------------------------------------------------

/// Why a booking lost its required adult-member coverage AFTER it was confirmed
/// (#2576 §7, §8). Exactly two causes, because there are exactly two ways it can
/// happen: an authorised Booking Officer deliberately overrode the refusal, or an
/// authoritative change outside the ordinary member edit flow (a membership
/// lapse, an administrative cancellation, a lifecycle transition, a data
/// correction) removed the cover and could not reasonably be blocked. An ordinary
/// member self-service change is neither: it is refused before it commits, so it
/// never produces an incident.
enum HostingCoverageIncidentCause {
  OFFICER_OVERRIDE
  SYSTEM_CHANGE
}

/// How an incident stopped being a live problem (#2576 §7, §16). Recorded rather
/// than inferred, because "coverage came back" and "the booking was cancelled"
/// are the same absence of a hazard and a very different story for an officer
/// reading the history.
enum HostingCoverageIncidentResolution {
  COVERAGE_RESTORED
  BOOKING_AMENDED
  EXCEPTION_APPROVED
  BOOKING_CANCELLED
}

/// A confirmed booking that is carrying uncovered non-member guest-nights
/// (#2576 §7, §16).
///
/// NOT A SECOND HOSTING REVIEW. `Booking.adultMemberHostingReview*` records what
/// the rule currently says about a booking and is reset whenever the hazard
/// materially changes; this table records that cover was TAKEN AWAY from a
/// booking that had already been accepted, which is a different fact with a
/// different lifecycle. The booking keeps its beds, its payments and its status —
/// §7 and §16 both forbid automatic cancellation in as many words — and this row
/// is what puts it in front of an officer and keeps it there until somebody
/// resolves it.
///
/// ONE ACTIVE ROW PER BOOKING, enforced by the partial unique index
/// `HostingCoverageIncident_active_booking_unique` (raw SQL, since Prisma cannot
/// express a predicated index; recorded in prisma/partial-unique-indexes.tsv).
/// That is what makes "create or update one durable active incident for the
/// materially identical uncovered state" (§16) an invariant rather than a hope:
/// a concurrent second opener loses on the index instead of doubling the queue.
/// Resolved rows accumulate as history and are outside the predicate.
model HostingCoverageIncident {
  id        String @id @default(cuid())
  bookingId String

  /// Denormalized copy of the booking's lodge, captured once at open time so the
  /// officer queue can filter and index by lodge without a join. Safe because
  /// `Booking.lodgeId` is immutable — a booking never changes lodge, it is
  /// cancelled and re-made — so this copy cannot drift.
  lodgeId String

  cause HostingCoverageIncidentCause

  /// Fingerprint of the uncovered state this row is about: the policy revision
  /// plus the exact uncovered guest/night pairs, in the deterministic order the
  /// evaluator produces. Two reconciliations of the same unchanged problem
  /// compute the same key and update nothing, which is what makes both the
  /// incident and its notification idempotent (§8, §16).
  stateKey String @db.VarChar(300)

  /// The frozen hosting violation as evidence — the same snapshot shape the
  /// review column stores, so an officer sees one evidence format. Kept in full
  /// here (member ids included) because this row is only ever read under admin
  /// booking permissions; the member-facing wording is derived, never this JSON.
  evidence Json

  /// The officer who overrode the refusal, for an OFFICER_OVERRIDE incident, and
  /// their mandatory reason (§7). A real foreign key for the same reason
  /// `Booking.adultMemberHostingReviewedById` is one: "an officer approved this"
  /// is only an audit answer if the officer is a real member row.
  overriddenByMemberId String?
  overrideReason       String? @db.VarChar(500)

  /// The state key the booking owner was last notified about. Notifications are
  /// TRANSITION-based (§16): a reconciliation that recomputes the same key sends
  /// nothing, and a materially different uncovered state notifies once more.
  notifiedStateKey String?   @db.VarChar(300)
  ownerNotifiedAt  DateTime?

  /// Short-lived delivery lease. This is intentionally separate from
  /// notifiedStateKey: the latter records a SUCCESSFUL send only. A failed
  /// sender releases this claim so the durable re-evaluation can retry.
  ownerNotificationClaimStateKey String?   @db.VarChar(300)
  ownerNotificationClaimedAt     DateTime?
  ownerNotificationClaimToken    String?   @db.VarChar(64)

  openedAt   DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  resolution HostingCoverageIncidentResolution?

  booking      Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  overriddenBy Member? @relation("HostingCoverageIncidentsOverridden", fields: [overriddenByMemberId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([resolvedAt, openedAt])
  @@index([lodgeId, resolvedAt])
}

/// Bounded re-evaluation work recorded durably in the transaction that caused it
/// (#2576 §8).
///
/// The outbox half of "allow the authoritative change, then re-read current facts
/// after commit". A membership lapse, an administrative cancellation or a
/// lifecycle transition must not be blocked and must not run the dependent
/// re-evaluation inline — the facts it needs are the COMMITTED ones, and doing
/// provider-free-but-multi-booking work inside somebody else's money transaction
/// is how a lock is held too long. So the authoritative writer records exactly
/// which owner, lodge and nights need looking at, and the work is drained after
/// commit (inline, best-effort) or by the general cron sweep (authoritative).
///
/// BOUNDED BY CONSTRUCTION, which is the point §10 insists on: an item names one
/// `memberId`, one lodge and an explicit night list. There is no lodge-wide sweep
/// here and no way to express one.
model HostingCoverageReevaluation {
  id String @id @default(cuid())

  /// The booking OWNER whose same-owner bookings need re-evaluating. A real
  /// foreign key rather than a snapshot column: this is a live pointer used to
  /// re-read facts, so a member merge has to repoint it or the queued work would
  /// look at an account that no longer holds the bookings.
  memberId String

  /// The affected lodge. A plain column, not a relation: the item is transient
  /// work, lodges are never deleted (every booking relation to them is
  /// Restrict), and the authoritative lodge for any incident this produces is
  /// the booking's own.
  lodgeId String

  /// Sorted, unique NZ lodge-nights (YYYY-MM-DD) to re-evaluate. JSON rather
  /// than a scalar list so the shape is one column and one write.
  nights Json

  cause HostingCoverageIncidentCause

  /// What caused the work, for the audit trail and for the incident this may
  /// open: the booking that changed, the officer who acted, and their reason.
  sourceBookingId String?
  actorMemberId   String?
  reason          String? @db.VarChar(500)

  enqueuedAt  DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?   @db.VarChar(1000)
  claimToken     String?   @db.VarChar(64)
  claimExpiresAt DateTime?

  member Member @relation("HostingCoverageReevaluations", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([processedAt, enqueuedAt])
  @@index([memberId, lodgeId])
}

// ---------------------------------------------------------------------------
// Xero OAuth Token (single row)
// ---------------------------------------------------------------------------

model XeroToken {
  id                     String    @id @default(cuid())
  accessToken            String
  refreshToken           String
  expiresAt              DateTime
  tenantId               String?
  refreshInProgressUntil DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Encrypted integration credentials (guided provider setup — #2079)
// ---------------------------------------------------------------------------
//
// Provider credentials (Xero client id/secret/webhook key here; Stripe/Google/
// Backup in later epic lanes) encrypted at rest with AES-256-GCM under a key
// derived from the app auth secret via HKDF-SHA256. The database is the ONLY
// credential source — legacy provider env vars are detected and flagged, never
// honoured. Standalone table (no FK coupling) so the migration is a pure
// blue/green EXPAND. See src/lib/integration-crypto.ts and
// src/lib/integration-credentials.ts.
model IntegrationCredential {
  id           String   @id @default(cuid())
  // Logical provider namespace, e.g. "xero", "stripe", "google", "backup".
  provider     String
  // Credential slot within the provider, e.g. "client_id", "client_secret",
  // "webhook_key", "token_key". Disjoint from two-factor's label namespace.
  key          String
  ciphertext   String
  iv           String
  authTag      String
  // Which auth-secret env var the wrapping key was derived from at write time
  // (AUTH_SECRET | NEXTAUTH_SECRET) — a silent fallback flip stays diagnosable
  // without ever exposing the value.
  secretSource String
  // HKDF info-label version used to derive the wrapping key, e.g.
  // "integration-credential:v1" / "xero-token-key:v1".
  labelVersion String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Full Admin member id that last wrote this credential (audit provenance).
  // Plain string, not an FK, to keep the table standalone/expand-safe.
  updatedByUserId String?

  @@unique([provider, key])
  @@index([provider])
  @@index([updatedAt])
}

// Per-wizard cursor + acknowledged-step state for the reusable guided-provider
// setup shell (#2080). ONE row per wizard id ("xero" here; "stripe"/"google"
// later) — the shell is provider-agnostic, so this table is too. Deliberately
// NOT the setup-readiness progress store (SETUP_STEP_IDS in setup-readiness.ts):
// that tracks 15 fixed checklist steps with complete/skip flags and has no
// per-wizard cursor. Each step's verified gate is re-derived from live server
// state on load; this row is only the RESUME cursor + acknowledgement record so
// a reload mid-flow returns to the right step, never a source of truth for
// whether a step is actually verified.
model IntegrationWizardProgress {
  id               String   @id @default(cuid())
  // Logical wizard namespace, matching a provider ("xero" | "stripe" | "google").
  wizardId         String   @unique
  // The step id the operator was last on (resume target).
  currentStepId    String
  // Step ids the operator has acknowledged / advanced past. Advisory only:
  // verification is always re-derived from server truth on load.
  completedStepIds String[]
  updatedAt        DateTime @updatedAt
  // Full Admin/area-admin member id that last advanced the wizard (provenance).
  updatedByMemberId String?

  @@index([updatedAt])
}

// Intent-to-receive (ITR) receipt sink for a provider's inbound webhook
// subscription (#2081, C3). Xero's ITR validation request carries an EMPTY
// `events: []` array, so the per-event inbound-event recorder leaves no trace of
// a successful validation. This row is the explicit marker the setup wizard
// polls: one row per provider ("xero" here), stamped whenever a valid-signature
// empty-events POST arrives on the real webhook route.
//
// FRESHNESS SCOPING (binding, #2081): the verify only goes green on a marker
// whose `validatedAt` is newer than the operator's verify-start AND whose
// `keyFingerprint` matches the CURRENTLY stored webhook key — a stale marker
// from an earlier verification, or one recorded under a previous webhook key,
// can never satisfy a new verify. `keyFingerprint` is a non-reversible SHA-256
// of the webhook key (never the key itself), so replacing the key re-arms
// verification (the fingerprint stops matching) without exposing any secret.
model WebhookValidationReceipt {
  id             String   @id @default(cuid())
  // Logical provider namespace ("xero"; future providers reuse this table).
  provider       String   @unique
  // When the last valid ITR ping was received (server clock at receipt).
  validatedAt    DateTime
  // Non-reversible fingerprint (SHA-256 hex) of the webhook key that validated
  // it — binds the marker to a key identity WITHOUT ever storing the key.
  keyFingerprint String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Finance Snapshot Storage
// ---------------------------------------------------------------------------

model FinanceSyncRun {
  id                  String                         @id @default(cuid())
  workflow            String
  trigger             FinanceSyncRunTrigger
  status              FinanceSyncRunStatus           @default(RUNNING)
  startedAt           DateTime                       @default(now())
  completedAt         DateTime?
  snapshotCount       Int                            @default(0)
  totalRowCount       Int                            @default(0)
  xeroTenantId        String?
  requestedByMemberId String?
  resultSummary       Json?
  errorSummary        String?
  errorDetails        Json?
  metadata            Json?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  snapshots           FinanceSnapshot[]
  monthlyBalances     FinanceAccountMonthlyBalance[]

  @@index([workflow, startedAt])
  @@index([status, startedAt])
  @@index([trigger, startedAt])
}

model FinanceSnapshot {
  id              String              @id @default(cuid())
  snapshotType    FinanceSnapshotType
  scope           String              @default("default")
  asOfDate        DateTime            @db.Date
  periodStart     DateTime?           @db.Date
  periodEnd       DateTime?           @db.Date
  rowCount        Int                 @default(0)
  currency        String?
  sourceUpdatedAt DateTime?
  payload         Json
  syncRunId       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  syncRun         FinanceSyncRun?     @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@unique([snapshotType, scope, asOfDate], map: "FinanceSnapshot_snapshotType_scope_asOfDate_key")
  @@index([snapshotType, asOfDate])
  @@index([scope, asOfDate])
  @@index([syncRunId])
}

// One row per (statement kind, month, Xero account code): the monthly finance
// fact table the dashboard reads. PROFIT_AND_LOSS rows hold the month's net
// activity for a revenue/expense account; BALANCE_SHEET rows hold the closing
// month-end position for an asset/liability/equity account. Rows are replaced
// idempotently from multi-period Xero reports (12 months per sync), so late
// edits in Xero self-heal for a year back; older months come from backfill.
model FinanceAccountMonthlyBalance {
  id            String                      @id @default(cuid())
  statementKind FinanceMonthlyStatementKind
  scope         String                      @default("default")
  // Always the first day of the month, stored as an NZ date-only value.
  month         DateTime                    @db.Date
  // Normalized upper-case Xero GL code (matches FinanceReportCategoryMapping).
  accountCode   String                      @db.VarChar(40)
  accountId     String?
  accountName   String?                     @db.VarChar(200)
  // Xero account type (SALES, EXPENSE, BANK, CURRLIAB, ...) and class
