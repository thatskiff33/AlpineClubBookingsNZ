// ---------------------------------------------------------------------------
// Account Credits
// ---------------------------------------------------------------------------

model MemberCredit {
  id                          String     @id @default(cuid())
  memberId                    String
  amountCents                 Int // Positive = credit added, negative = credit used
  type                        CreditType
  description                 String // Human-readable reason
  requestedById               String? // Admin who requested a manual adjustment
  approvedById                String? // Admin who approved a manual adjustment
  approvalRequestId           String?    @unique // Links approved manual adjustments to their request
  sourceBookingId             String? // Booking that generated the credit (cancellation)
  // #1636: restore-per-source-booking dedupe key. Set ONLY by
  // restoreCreditFromBooking (alongside sourceBookingId), so a second restore of
  // the same booking's applied credit is structurally impossible independent of
  // the caller's advisory-lock granularity. A dedicated column — NOT the shared
  // sourceBookingId — because sourceBookingId + type=CANCELLATION_REFUND is
  // written by THREE legitimate paths for one booking (restoreCreditFromBooking,
  // createCancellationCredit's held-as-credit refund, and the Xero inbound
  // invoice-paid-effects late-cash credit), so a unique over (sourceBookingId,
  // type) would reject those co-occurring rows. Nullable + @unique => Postgres
  // permits many NULLs (every non-restore row) but at most one non-null per
  // booking. Bare scalar, not a FK: sourceBookingId's FK already carries
  // referential integrity to the same booking.
  restoredFromBookingId       String?    @unique
  sourceBookingModificationId String?    @unique // Booking modification that generated the credit
  appliedToBookingId          String? // Booking where credit was spent
  xeroCreditNoteId            String? // Linked Xero credit note ID
  createdAt                   DateTime   @default(now())

  member                    Member                        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  requestedBy               Member?                       @relation("RequestedAdminCredits", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy                Member?                       @relation("ApprovedAdminCredits", fields: [approvedById], references: [id], onDelete: SetNull)
  approvalRequest           AdminCreditAdjustmentRequest? @relation("ApprovedAdminCreditAdjustment", fields: [approvalRequestId], references: [id], onDelete: SetNull)
  sourceBooking             Booking?                      @relation("CreditSource", fields: [sourceBookingId], references: [id], onDelete: SetNull)
  sourceBookingModification BookingModification?          @relation("CreditSourceModification", fields: [sourceBookingModificationId], references: [id], onDelete: SetNull)
  appliedToBooking          Booking?                      @relation("CreditApplied", fields: [appliedToBookingId], references: [id], onDelete: SetNull)
  // #1620: slices of THIS credit lot (a positive funding row) that have been
  // allocated to booking invoices as Xero credit notes. Empty for negative
  // BOOKING_APPLIED rows and for lots never used to reduce an IB invoice.
  noteAllocations           MemberCreditNoteAllocation[]  @relation("CreditLotAllocations")

  @@index([memberId])
  @@index([requestedById])
  @@index([approvedById])
  @@index([sourceBookingId])
  @@index([appliedToBookingId])
}

/// #1620 — per-note credit-lot allocation ledger for "allocate-existing" applied
/// credit. When a member applies account credit to an Internet-Banking booking,
/// the raise-path allocation engine reduces the FULL Xero invoice by allocating
/// the member's existing floating ACCRECCREDIT notes (or a freshly minted note
/// for an admin-adjustment remainder that has no Xero note). Each row records one
/// mutable working slice of one funding lot consumed against one booking's
/// invoice. A funding
/// note's remaining unallocated balance = MemberCredit.amountCents (the positive
/// lot) minus the sum of amountCents over its allocation rows. Idempotency anchor
/// for the per-note Xero allocation outbox op (localModel
/// "MemberCreditNoteAllocation", localId = this row's id).
model MemberCreditNoteAllocation {
  id                 String   @id @default(cuid())
  // The positive funding MemberCredit lot this slice draws from.
  memberCreditId     String
  // The Xero credit note carrying the slice: the lot's existing floating note,
  // or a freshly minted note for an admin-adjustment (noteless) lot.
  xeroCreditNoteId   String
  // The booking whose Xero invoice the note is allocated against. Deliberately a
  // bare scalar with no FK to Booking (mirrors MemberCredit.restoredFromBookingId):
  // working slices can be reduced/deleted after provider-verified deallocation,
  // but remain bare scalars so booking hard-delete neither cascades nor blocks.
  // Durable equivalent audit survives in the XeroSyncOperation requestPayload
  // checkpoint/history and inactive/active XeroObjectLink provenance history.
  appliedToBookingId String
  // Positive cents drawn from the lot for this booking (never exceeds the lot's
  // remaining balance).
  amountCents        Int
  createdAt          DateTime @default(now())

  memberCredit MemberCredit @relation("CreditLotAllocations", fields: [memberCreditId], references: [id], onDelete: Restrict)

  // One slice per (lot, booking): the allocation engine re-runs idempotently and
  // upserts on this key. Explicit map: the default name would exceed Postgres's
  // 63-char identifier limit.
  @@unique([memberCreditId, appliedToBookingId], map: "MemberCreditNoteAllocation_lot_booking_key")
  @@index([appliedToBookingId])
  @@index([xeroCreditNoteId])
}

model AdminCreditAdjustmentRequest {
  id             String                             @id @default(cuid())
  memberId       String
  amountCents    Int
  description    String
  idempotencyKey String
  status         AdminCreditAdjustmentRequestStatus @default(PENDING)
  requestedById  String
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime                           @default(now())
  updatedAt      DateTime                           @updatedAt

  member         Member        @relation("AdminCreditAdjustmentTarget", fields: [memberId], references: [id], onDelete: Restrict)
  requestedBy    Member        @relation("AdminCreditAdjustmentRequestsRequested", fields: [requestedById], references: [id])
  reviewedBy     Member?       @relation("AdminCreditAdjustmentRequestsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedCredit MemberCredit? @relation("ApprovedAdminCreditAdjustment")

  @@unique([requestedById, idempotencyKey])
  @@index([memberId, status, createdAt])
  @@index([requestedById, createdAt])
  @@index([reviewedById, createdAt])
}

// ---------------------------------------------------------------------------
// Group Discount Settings (P5.1)
// ---------------------------------------------------------------------------

model GroupDiscountSetting {
  id           String   @id @default("default")
  minGroupSize Int      @default(5)
  summerOnly   Boolean  @default(true)
  enabled      Boolean  @default(false)
  // The membership type whose rate rows a qualifying group discount
  // substitutes for true non-members (rateSource = NON_MEMBER_DEFAULT). Seeded
  // to the built-in FULL type so a discounted non-member prices at the member
  // rate, exactly as the old boolean flip did. Members keep their own type's
  // rate and TYPE_POLICY_FORCED members are excluded (#1930, E4, D-note).
  rateMembershipTypeId String?
  // Whether a LATER EDIT to an existing booking may earn this discount on the
  // nights it newly buys — added nights on a date change or check-out
  // extension, and a guest added to a qualifying party (#2770, INV-MOD-026).
  // One switch for EVERY edit path, so the ordinary planner and the
  // in-progress planner can never price the same night differently again.
  // Default true: that is what every edit path already did (INV-MOD-006), so
  // no club's prices move because this column exists. When false, newly bought
  // nights on an edit price without the discount; nights a guest already
  // bought keep their stored price either way (INV-MOD-005), so turning it off
  // never re-rates history. Creation, the waitlist offer reprice and the
  // booking-request approval paths are unaffected — they are the first
  // purchase, not a later edit.
  applyToEdits Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Public PageContent data blocks are opt-in. Inserting a token is not enough:
// an administrator must also enable its family here before any authoritative
// fee or policy data is rendered publicly.
// Target the public "Book Now" button points at (E3 #1929).
enum BookNowTarget {
  BOOKING_FLOW
  PAGE
}

// Public committee-roster photo display (MP5, epic #171). NONE (default) shows
// the text-only roster and renders no photos publicly even for members who have
// one — a privacy-safe opt-in, mirroring the double-opt-in pattern used for
// sensitive public content (annualFees). CIRCLE/SQUARE show each published
// member's photo in that shape, with an initials placeholder for members
// without one.
enum CommitteePhotoDisplay {
  NONE
  CIRCLE
  SQUARE
}

model PublicContentSettings {
  id                   String   @id @default("default")
  membershipTypes      Boolean  @default(false)
  // Committee-roster photo display + shape (MP5, epic #171). See enum above.
  committeePhotoDisplay CommitteePhotoDisplay @default(NONE)
  entranceFees         Boolean  @default(false)
  hutFees              Boolean  @default(false)
  bookingPolicySummary Boolean  @default(false)
  cancellationPolicy   Boolean  @default(false)
  // Dedicated double-opt-in gate for the {{annual-fees}} embed (#1933, E7).
  // Annual membership fees are more sensitive than the entrance/joining headline
  // (D-R4), so they get their own visibility flag rather than reusing entranceFees.
  annualFees           Boolean  @default(false)
  // Configurable public "Book Now" button (E3 #1929). Default flipped to OFF in
  // #2430 (owner decision, 1 Aug 2026): a fresh install advertises no public
  // booking CTA until an admin ticks it on. The same migration
  // (20260802100000_public_book_now_default_off) also switches EXISTING clubs
  // off — the owner widened the decision on PR #2466, accepting that it
  // overrides a saved choice — so after that release no club shows the button
  // until an admin ticks it back on. When target is
  // PAGE, bookNowPageId names a published PageContent; getBookNowConfig() fails
  // open to the booking flow if the page is missing/unpublished, so the button
  // is never dead. The FK is SetNull so an out-of-band delete cannot leave a
  // dangling id — but SetNull alone would leave the PAIR at PAGE + null, which
  // the settings PUT refuses to save, so the supported page delete
  // (app/api/admin/page-content/route.ts DELETE) writes bookNowTarget back to
  // BOOKING_FLOW in the same transaction (#2352, first review finding 1).
  showBookNow          Boolean       @default(false)
  bookNowTarget        BookNowTarget @default(BOOKING_FLOW)
  bookNowPageId        String?
  bookNowPage          PageContent?  @relation("PublicContentBookNowPage", fields: [bookNowPageId], references: [id], onDelete: SetNull)
  // Which committee role's member(s) appear in the public Contact page "Club
  // Details" block (admin-configured under Site Appearance & Content → Club
  // Identity → Club Contact). Stores the CommitteeRole.key; null falls back to
  // the legacy booking-officer heuristic. A stored key that no longer matches an
  // active role simply shows no contact — no FK so a role rename/delete never
  // blocks or dangles here.
  contactCommitteeRoleKey String?
  updatedByMemberId    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([bookNowPageId])
}

// ---------------------------------------------------------------------------
// Club Theme (public website visual branding)
// ---------------------------------------------------------------------------

model ClubTheme {
  id             String        @id @default("default")
  brandGold      String
  brandDeep      String
  brandSafety    String
  // #2187 epic #2181: a club picks THREE seeds (brandGold/brandDeep/brandSafety)
  // that feed the vendored Radix generator for the full 12-step substrate. The
  // four former brand columns (brandCharcoal/brandRidge/brandMist/brandSnow) were
  // dead to code from P1 (derived at render time by deriveBrandShims) and were
  // dropped by the P4 CONTRACT migration
  // 20260722160000_contract_drop_club_theme_orphan_columns after P1's EXPAND
  // (20260722140000_expand_club_theme_orphan_column_defaults) drained.
  headingFontKey ClubThemeFont @default(LEAGUE_SPARTAN)
  bodyFontKey    ClubThemeFont @default(INTER)
  // #2322: the logo is stored as a served image URL (`/api/images/<MediaImage
  // id>`, immutably cached) rather than inlined base64. `logoDataUrl` is kept
  // for the deployments that already hold one — render precedence is
  // logoUrl ?? logoDataUrl ?? text fallback, and saving a new logo clears the
  // data-URI. Both nullable; neither is ever populated by default.
  logoUrl        String?
  logoDataUrl    String?
  rawCss         String        @default("")
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
