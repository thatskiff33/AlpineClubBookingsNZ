{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Keep exports that are referenced only within their own file (e.g. a constant
  // or function exported for a sibling test but also used internally). This
  // collapses the bulk of the "unused type-only export" surface that #1129/#1178
  // deliberately kept, leaving only exports with genuinely zero references.
  "ignoreExportsUsedInFile": true,
  "entry": [
    // Framework / tooling entry points knip's plugins cannot trace to their caller.
    // Playwright reaches this only via `testMatch: /auth\.setup\.ts/` in playwright.config.ts.
    "e2e/auth.setup.ts",
    // Invoked from scripts/e2e-stack.sh (shell), never imported.
    "e2e/setup/enable-e2e-modules.ts",
    // Invoked from scripts/e2e-stack.sh (shell) to relativize booking seasons on
    // the E2E DB so seeded fixtures never expire (#2117), never imported.
    "e2e/setup/relativize-seasons.ts",
    // Invoked from scripts/e2e-stack.sh (shell) only when E2E_MULTI_LODGE=1
    // (advisory multi-lodge project, #1568), never imported.
    "e2e/setup/seed-second-lodge.ts",
    // Invoked from scripts/e2e-stack.sh (shell) to seed test-mode Stripe keys
    // into the encrypted credential store (#2082), never imported.
    "e2e/setup/seed-stripe-credentials.ts",
    // Invoked by hand (node scripts/branding/generate-calendar-icons.mjs) to
    // regenerate the committed add-to-calendar email icons under
    // public/branding/calendar/ (fork #41); never imported.
    "scripts/branding/generate-calendar-icons.mjs",
    // Invoked from scripts/codex/run-next-issue.sh + docs, never imported.
    "scripts/codex/create-review-issues.mjs",
    "scripts/codex/issue-to-prompt.mjs",
    // Documented operator CLI (docs/MAINTENANCE.md, docs/xero/ARCHITECTURE.md).
    "scripts/xero-booking-repair.ts",
    // Documented operator CLI (#2901, docs/xero/ARCHITECTURE.md → "Repairing
    // Stripe refund-note links"; invoked via `npx tsx`, never imported).
    "scripts/xero-refund-note-link-repair.ts",
    // Documented operator CLI (docs/MAINTENANCE.md, docs/DOMAIN_INVARIANTS.md,
    // docs/STATE_MACHINES.md; invoked via `npx tsx`, never imported).
    "scripts/backfill-orphaned-applied-credits.ts",
    // Documented read-only operator CLI (docs/MAINTENANCE.md, #1597; invoked via
    // `npx tsx`, never imported). Audits under-cleared IB hold-expiry invoices.
    "scripts/audit-ib-hold-clearing.ts",
    // Documented read-only diagnostic CLI (docs/guides/calendar.md; invoked via
    // `npx tsx`, never imported). Explains a member's calendar edit access.
    "scripts/diagnose-calendar-access.ts"
    // NOTE: scripts/diagnostics/generate-knowledge-bundle.ts (AID-3, #2372) does
    // NOT need an entry — knip's package.json plugin already reaches it through
    // the `diagnostics:bundle` npm script.
    // `src/instrumentation.node.ts` deliberately has NO entry here. It used to
    // (#1178), partly justified by an `onRequestError` export that Next never
    // reads from this file — that hook now lives on `src/instrumentation.ts`,
    // where the framework actually looks (#2356 review). The remaining
    // justification was hollow too: knip already follows the dynamic
    // `import("./instrumentation.node")` in `src/instrumentation.ts`, which the
    // Next plugin supplies as an entry, so the carve-out changed nothing.
    // Verified by removing it and re-running `npx knip` (exit 0).
  ],
  // The k6 load harness (#1884) is operator-invoked tooling that runs under the
  // k6 binary, not Node/Next — its scripts import k6-runtime modules (k6/http,
  // k6/execution, ...) that are not npm packages, so knip cannot analyze them.
  // Dead-code coverage for load/ comes from `node --check` + eslint instead.
  // The #2352/#2663 measurement harness is operator-invoked evidence tooling.
  // Every .mjs under measurement/ is a standalone script a shell runner spawns
  // with `node <path>` or that another such script imports at a path knip does
  // not follow, so knip sees ~50 unreferenced files. It is deliberately outside
  // CI and is removed again in the follow-up PR once the figure is recorded
  // (owner decision on #2663), so this entry goes with it. Dead-code coverage
  // for measurement/ comes from its own three self-tests plus `node --check`
  // and `bash -n`.
  // #2686: `.semgrep/**` holds the repository's own Semgrep rules and their
  // must-fail/must-pass fixtures. Nothing in the application imports them —
  // Semgrep reads them directly, and the `Static analysis gate` job runs
  // `semgrep --test` over them on every pull request, which is what proves they
  // are alive. knip would report every fixture as an unused file.
  "ignore": ["load/**", "measurement/**", ".semgrep/**"],
  "ignoreBinaries": [
    // Runtime shell-outs; these binaries live on the host/container, not node_modules.
    // #2418: the data-migration gate's contract test runs the shared awk statement
    // splitter (scripts/lib/split-sql-statements.awk) directly, to prove it agrees
    // with the TypeScript splitter the runner executes with.
    "awk",
    "psql", // src/lib/backup.ts + scripts/audit-access-role-membership-cleanup.ts
    "pg_dump", // src/lib/backup.ts logical backups
    "gunzip", // src/lib/backup.ts restore path
    "k6" // load/ harness, run via the `load:*` scripts (#1884); host binary, not a dep
  ],
  "ignoreIssues": {
    // shadcn/ui vendored primitives keep the full Radix-parity export/type surface
    // by design; unused idiom exports are expected (#1129/#1178 kept class).
    "src/components/ui/**": ["exports", "types"],
    // Intentional backward-compat alias
    // getMemberProfileCompleteness = evaluateMemberProfileCompleteness.
    "src/lib/member-profile-completeness.ts": ["duplicates"],
    // Intentional documented alias SCHOOL_GROUP_SOFT_CAP = DEFAULT_SCHOOL_GROUP_SOFT_CAP
    // (both names live; landed 2026-07-08 school-bookings work).
    "src/lib/school-booking-constants.ts": ["duplicates"],
    // WhakapapaChairlift type alias landed 2026-07-08 (snow-conditions refactor)
    // with zero refs; kept pending owner triage at the #1526 PR — see PR body.
    "src/lib/whakapapa-report.ts": ["types"],
    // #2079 (epic #2078) foundation surface: the credential store is the shared
    // contract the later lanes consume — deleteIntegrationCredential (C4/C5/C6
    // credential resets), ProviderCredentialState (the canonical per-provider
    // state model the issue body requires C1 to export for C2–C6), and the
    // IntegrationLabelVersion union. Remove these carve-outs as the consuming
    // lanes land.
    "src/lib/integration-credentials.ts": ["exports", "types"],
    "src/lib/integration-crypto.ts": ["types"],
    // #1138 booking-modify split: this file's header comment states it is
    // "now a pure barrel" so "everything importable from @/lib/booking-modify
    // is unchanged" — a deliberate backward-compat contract. Several flagged
    // exports/types aren't currently pulled through this path (callers import
    // the split modules directly), but the barrel itself stays actively used
    // for others, so the contract still matters.
    "src/lib/booking-modify.ts": ["exports", "types"],
    // #1744: PARTNER_LINK_PENDING/CONFIRMED are re-exported from
    // member-partner-link-shared.ts "so existing importers keep working" (see
    // the comment right above the re-export) even though the sole current
    // consumer (double-bed-sharing.ts) now imports them from the shared leaf
    // module directly.
    "src/lib/member-partner-link.ts": ["exports"],
    // #1208 item 2: this file's header comment states it "re-exports the
    // exact public surface so external importers still resolve" after the
    // ~2,700-line module split. scripts/xero-booking-repair.ts (an
    // already-declared entry above) and its test are the real consumers, just
    // not of every re-exported name.
    "src/lib/xero-booking-repair.ts": ["exports", "types"],
    // #1208 item 5: same documented "keeps the exact public surface" facade
    // pattern as xero-booking-repair.ts above, for the Xero hardening split
    // (xero-cron-runner, the admin link-maintenance route, xero-sync, tests).
    "src/lib/xero-hardening.ts": ["types"],
    // Sibling of xero-hardening.ts in the same #1208-style xero-inbound
    // split: a pure barrel over ./xero-inbound/types and
    // ./xero-inbound/event-processing, actively used for
    // runXeroInboundReconciliationCycle/replayStoredXeroInboundEvent/
    // XeroInboundReplayError; the five flagged *Result types are internal
    // plumbing types re-exported for parity, not currently consumed by name.
    "src/lib/xero-inbound-reconciliation.ts": ["types"],
    // "Xero Integration Library — compatibility facade" (see the file's own
    // header docblock): re-exports the focused xero-* modules' public surface
    // "so existing callers can continue to import from @/lib/xero without
    // churn." The flagged names are still fully live in their true home
    // modules (xero-token-store, xero-mappings, xero-contacts,
    // xero-member-import), just not currently reached via this facade path.
    "src/lib/xero.ts": ["exports", "types"]
  }
}
